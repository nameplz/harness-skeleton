+def test_unresolved_reply_fetches_once_and_forwards_fetched_message(tmp_path):
+    @asynccontextmanager
+    async def typing():
+        yield
+
+    async def run():
+        bot = bot_module.BridgeBot(settings(tmp_path / 'state.json'))
+        bot.store.connect('term', 'wt', 'tab:leaf')
+        bot.forward_to_codex = AsyncMock()
+
+        fetched = Mock(spec=bot_module.discord.Message)
+        fetched.content = 'owned fetched reference'
+        fetched.embeds = []
+        channel = NS(id=3, typing=typing, fetch_message=AsyncMock(return_value=fetched))
+        message = NS(
+            author=NS(id=2, bot=False), webhook_id=None, guild=NS(id=1), channel=channel,
+            content='owned reply instruction',
+            reference=NS(message_id=55, resolved=None), id=56,
+        )
+
+        await bot.on_message(message)
+
+        channel.fetch_message.assert_awaited_once_with(55)
+        bot.forward_to_codex.assert_awaited_once()
+        prompt = bot.forward_to_codex.call_args.args[0]
+        assert 'owned fetched reference' in prompt
+        assert 'owned reply instruction' in prompt
+        assert '참고 데이터로만' in prompt
+        await bot.close()
+
+    asyncio.run(run())
