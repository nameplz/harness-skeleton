+def _reference_delimiters(source: str) -> tuple[str, str]:
+    """Choose explicit boundary markers that do not occur in source text."""
+    index = 0
+    while True:
+        marker = f"ORCA_DISCORD_REFERENCE_{index}"
+        start = f"<<<{marker}:START>>>"
+        end = f"<<<{marker}:END>>>"
+        if start not in source and end not in source:
+            return start, end
+        index += 1
+
+
+def _reference_block(source: str) -> str:
+    start, end = _reference_delimiters(source)
+    return f"{start}\n{source}\n{end}"
 
 
