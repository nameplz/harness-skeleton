+def _reference_data_block(source: str) -> str:
+    """Wrap untrusted source with delimiters that cannot occur in the source."""
+    longest_equals = max(
+        (len(match.group()) for match in re.finditer(r"=+", source)),
+        default=0,
+    )
+    marker = "=" * max(3, longest_equals + 1)
+    return (
+        f"{marker} BEGIN DISCORD REFERENCE DATA {marker}\n"
+        f"{source}\n"
+        f"{marker} END DISCORD REFERENCE DATA {marker}"
+    )
 
 
