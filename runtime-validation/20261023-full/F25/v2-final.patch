+def test_unresolved_reply_is_fetched_and_forwarded(tmp_path):
+    @asynccontextmanager
+    async def typing():
+        yield
+
+    async def run():
+        bot=bot_module.BridgeBot(settings(tmp_path/'state.json'))
+        bot.store.connect('term','wt','tab:leaf')
+        bot.forward_to_codex=AsyncMock()
+        reference=bot_module.discord.Message.__new__(bot_module.discord.Message)
+        reference.content='fetched reference content'
+        reference.embeds=[]
+        channel=NS(id=3,typing=typing,fetch_message=AsyncMock(return_value=reference))
+        message=NS(author=NS(id=2,bot=False),webhook_id=None,guild=NS(id=1),channel=channel,
+                   content='summarize this reply',reference=NS(message_id=17,resolved=None),id=18,reply=AsyncMock())
+
+        await bot.on_message(message)
+
+        channel.fetch_message.assert_awaited_once_with(17)
+        bot.forward_to_codex.assert_awaited_once()
+        prompt=bot.forward_to_codex.call_args.args[0]
+        assert 'fetched reference content' in prompt
+        assert '=== BEGIN DISCORD REFERENCE DATA ===' in prompt
+        assert '=== END DISCORD REFERENCE DATA ===' in prompt
+        assert '사용자 지시: summarize this reply' in prompt
+        await bot.close()
+
+    asyncio.run(run())
