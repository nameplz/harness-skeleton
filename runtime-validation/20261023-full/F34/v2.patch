+def test_state_store_migrates_valid_legacy_json(tmp_path):
+    path = tmp_path / 'owned/state.json'
+    path.parent.mkdir()
+    path.write_text(json.dumps({
+        'terminal_handle': 'legacy-term',
+        'worktree_id': 'legacy-worktree',
+        'pane_key': 'legacy-pane',
+        'ignored': 'legacy-extra',
+    }))
+    path.chmod(0o644)
+
+    store = StateStore(path)
+    assert store.state.terminal_handle == 'legacy-term'
+    assert store.state.worktree_id == 'legacy-worktree'
+    assert store.state.pane_key == 'legacy-pane'
+    assert path.read_bytes().startswith(b'SQLite format 3\x00')
+    assert stat.S_IMODE(path.stat().st_mode) == 0o600
+    assert StateStore(path).state.pane_key == 'legacy-pane'
+
+
+@pytest.mark.parametrize(
