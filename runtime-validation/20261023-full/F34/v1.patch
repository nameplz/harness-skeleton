+def test_state_sqlite_roundtrip_and_restart(tmp_path):
+    path = tmp_path / 'owned/state.json'
+    store = StateStore(path)
+
+    assert store.path == path
+    assert store.state.terminal_handle is None
+    connection = sqlite3.connect(path)
+    try:
+        assert connection.execute('PRAGMA integrity_check').fetchone() == ('ok',)
+    finally:
+        connection.close()
+
+    store.connect('term', 'wt', 'tab:leaf')
+    reopened = StateStore(path)
+    assert reopened.state.terminal_handle == 'term'
+    assert reopened.state.worktree_id == 'wt'
+    assert reopened.state.pane_key == 'tab:leaf'
+
+    reopened.disconnect()
+    disconnected = StateStore(path)
+    assert disconnected.state.terminal_handle is None
+    assert disconnected.state.worktree_id is None
+    assert disconnected.state.pane_key is None
+
+
