+def test_state_rejects_symlink_without_modifying_target(tmp_path):
+    target = tmp_path / 'owned-target.json'
+    target.write_text(json.dumps({'terminal_handle': 'term'}), encoding='utf-8')
+    target.chmod(0o644)
+    original_content = target.read_bytes()
+    original_mode = stat.S_IMODE(target.stat().st_mode)
+    path = tmp_path / 'owned-state.json'
+    path.symlink_to(target)
