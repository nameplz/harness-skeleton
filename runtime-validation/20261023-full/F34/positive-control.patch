+def test_state_store_rejects_symlinks_without_touching_target(tmp_path):
+    target = tmp_path / 'target.sqlite3'
+    protected = StateStore(target)
+    protected.connect('protected-term', 'protected-worktree', 'protected-pane')
+    original = target.read_bytes()
+    target.chmod(0o644)
+
+    link_dir = tmp_path / 'owned'
+    link_dir.mkdir()
+    reopen_path = link_dir / 'reopen.sqlite3'
+    reopen_path.symlink_to(target)
+    with pytest.raises(OSError, match='symlink'):
+        StateStore(reopen_path)
+
+    save_path = link_dir / 'save.sqlite3'
+    store = StateStore(save_path)
+    store.connect('other-term', 'other-worktree', 'other-pane')
+    save_path.unlink()
+    save_path.symlink_to(target)
+    with pytest.raises(OSError, match='symlink'):
+        store.save()
+
+    assert target.read_bytes() == original
+    assert stat.S_IMODE(target.stat().st_mode) == 0o644
 
 
