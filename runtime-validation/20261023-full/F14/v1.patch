+def _status_report_text(screen: str) -> str:
+    """Keep the /status report while dropping prompt text and TUI frame decoration."""
+    lines: list[str] = []
+    for raw in screen.splitlines():
+        line = raw.strip()
+        if not line:
+            continue
+        if all(ch in _STATUS_SEPARATOR_CHARS for ch in line):
+            continue
+
+        # Orca may return a screen line with box-drawing characters around its content.
+        line = line.strip(_STATUS_FRAME_CHARS).strip()
+        if not line:
+            continue
+        if line.startswith(("›", ">", "❯")):
+            continue
+        if "ask codex to do anything" in line.casefold():
+            continue
+        lines.append(line)
+    return "\n".join(lines).strip()
