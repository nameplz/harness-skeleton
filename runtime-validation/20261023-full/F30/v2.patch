@@ -11,6 +11,32 @@ class ConfigError(RuntimeError):
     pass
 
 
+def _optional_role_ids(name: str) -> frozenset[int]:
+    value = os.getenv(name, "")
+    if not value.strip():
+        return frozenset()
+
+    role_ids: set[int] = set()
+    for raw_role_id in value.split(","):
+        role_id = raw_role_id.strip()
+        if not role_id or not role_id.isascii() or not role_id.isdigit():
+            raise ConfigError(
+                f"{name} must be a comma-separated list of positive integer Discord role IDs"
+            )
+        try:
+            parsed_role_id = int(role_id)
+        except ValueError as exc:
+            raise ConfigError(
+                f"{name} must be a comma-separated list of positive integer Discord role IDs"
+            ) from exc
+        if not 0 < parsed_role_id < 2**64:
+            raise ConfigError(
+                f"{name} must be a comma-separated list of positive integer Discord role IDs"
+            )
+        role_ids.add(parsed_role_id)
+    return frozenset(role_ids)
+
+
