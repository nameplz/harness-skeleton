+def test_role_authorization_precedes_every_entrypoint_operation(tmp_path, surface, actor):
+    @asynccontextmanager
+    async def typing():
+        yield
+
+    async def run():
+        bot=bot_module.BridgeBot(settings(tmp_path/'state.json',frozenset({41})))
+        source=NS(content='owned context',embeds=[])
+        allowed=actor in {'owner','configured_role'}
+        guild=7 if actor=='other_guild' else None if actor=='dm' else 1
+        user=2 if actor=='owner' else 7
+        roles=(41,) if actor in {'configured_role','other_guild','dm'} else (99,) if actor=='unconfigured_role' else ()
+        request=interaction(bot,guild=guild,user=user,roles=roles)
+
+        if surface.startswith('slash_'):
+            binding=orca.TerminalBinding('term','wt','tab','leaf')
+            bot.orca=NS(list_terminals=AsyncMock(return_value=[]),
+                        validate_codex_binding=AsyncMock(return_value=binding),
+                        get_agent_snapshot=AsyncMock(return_value=orca._parse_agent_snapshot(row())))
+            if surface in {'slash_status','slash_disconnect'}:
+                bot.store.connect('term','wt','tab:leaf')
+        if surface=='slash_terminals':
+            await bot_module.terminals_command.callback(request)
+            assert bot.orca.list_terminals.await_count == int(allowed)
+            if not allowed:
+                request.response.send_message.assert_awaited_once()
+                request.response.send_message.assert_awaited_with(
+                    '허용된 사용자 또는 역할만 사용할 수 있습니다.' if guild==1
+                    else '이 서버에서는 사용할 수 없습니다.', ephemeral=True)
+            assert bot.orca.validate_codex_binding.await_count==0
+            assert bot.orca.get_agent_snapshot.await_count==0
+        elif surface=='slash_connect':
+            await bot_module.connect_command.callback(request,'term')
+            assert bot.orca.validate_codex_binding.await_count==int(allowed)
+            assert bot.orca.list_terminals.await_count==0
+            assert bot.orca.get_agent_snapshot.await_count==0
+            assert bot.store.state.terminal_handle==('term' if allowed else None)
+            if not allowed:
+                request.response.send_message.assert_awaited_once()
