+            assert bot.orca.validate_codex_binding.await_count==int(allowed)
+            assert bot.orca.get_agent_snapshot.await_count==int(allowed)
+            assert bot.orca.list_terminals.await_count==0
+            assert bot.store.state.terminal_handle=='term'
+            if not allowed:
