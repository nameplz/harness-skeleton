+def _optional_role_ids() -> frozenset[int]:
+    value = os.getenv("DISCORD_ROLE_IDS", "").strip()
+    if not value:
+        return frozenset()
+
+    parts = [part.strip() for part in value.split(",")]
+    if any(not part.isascii() or not part.isdigit() for part in parts):
+        raise ConfigError("DISCORD_ROLE_IDS must be a comma-separated list of integer Discord role IDs")
+
+    try:
+        role_ids = [int(part) for part in parts]
+    except ValueError as exc:
+        raise ConfigError("DISCORD_ROLE_IDS must be a comma-separated list of integer Discord role IDs") from exc
+    if any(role_id <= 0 or role_id >= 2**64 for role_id in role_ids):
+        raise ConfigError("DISCORD_ROLE_IDS must contain positive 64-bit Discord role IDs")
+    return frozenset(role_ids)
+
+
