+def test_role_authorization_covers_autocomplete_context_modal_and_message(tmp_path):
+    @asynccontextmanager
+    async def typing():
+        yield
+
+    async def run():
+        bot=bot_module.BridgeBot(settings(tmp_path/'state.json', role_ids={44}))
+        bot.orca=NS(list_terminals=AsyncMock(return_value=[
+            orca.TerminalInfo('term','owned','wt','codex')
+        ]))
+        bot.forward_to_codex=AsyncMock()
+        bot.store.connect('term','wt','tab:leaf')
+
+        role_request=interaction(bot,user=7,roles=(44,))
+        assert await bot_module.terminal_autocomplete(role_request,'owned')
+        bot.orca.list_terminals.assert_awaited_once()
+        for denied in (
+            interaction(bot,user=7,roles=(55,)),
+            interaction(bot,user=8,roles=(55,)),
+            interaction(bot,guild=7,user=7,roles=(44,)),
+            interaction(bot,guild=None,user=7,roles=(44,)),
+        ):
+            calls=bot.orca.list_terminals.await_count
+            assert await bot_module.terminal_autocomplete(denied,'') == []
+            assert bot.orca.list_terminals.await_count == calls
+
+        source=NS(content='owned untrusted context',embeds=[])
+        context_request=interaction(bot,user=7,roles=(44,))
+        await bot_module.send_to_codex_context.callback(context_request,source)
+        context_request.response.send_modal.assert_awaited_once()
+        modal=context_request.response.send_modal.call_args.args[0]
+        modal.instruction._value='owned instruction'
+
+        for denied in (
+            interaction(bot,user=7,roles=(55,)),
+            interaction(bot,user=8,roles=(55,)),
+            interaction(bot,guild=7,user=7,roles=(44,)),
+            interaction(bot,guild=None,user=7,roles=(44,)),
+        ):
+            await bot_module.send_to_codex_context.callback(denied,source)
+            denied.response.send_modal.assert_not_awaited()
+
+        await modal.on_submit(interaction(bot,user=7,roles=(44,)))
+        bot.forward_to_codex.assert_awaited_once()
+        for denied in (
+            interaction(bot,user=7,roles=(55,)),
+            interaction(bot,user=8,roles=(55,)),
+            interaction(bot,guild=7,user=7,roles=(44,)),
+            interaction(bot,guild=None,user=7,roles=(44,)),
+        ):
+            calls=bot.forward_to_codex.await_count
+            await modal.on_submit(denied)
+            denied.response.send_message.assert_awaited_once()
+            assert bot.forward_to_codex.await_count == calls
+
+        message=NS(author=NS(id=7,bot=False,roles=[NS(id=44)]),webhook_id=None,
+                   guild=NS(id=1),channel=NS(id=3,typing=typing),content='owned prompt',
+                   reference=None,id=8)
+        await bot.on_message(message)
+        assert bot.forward_to_codex.await_args_list[-1].args == ('owned prompt',)
+        assert bot.forward_to_codex.await_args_list[-1].kwargs == {
+            'origin': 'Discord message 8'
+        }
+        assert bot.forward_to_codex.await_count == 2
+        await bot.close()
+    asyncio.run(run())
+
