diff --git a/src/orca_discord_bridge/config.py b/src/orca_discord_bridge/config.py
index 46011d2..7839026 100644
--- a/src/orca_discord_bridge/config.py
+++ b/src/orca_discord_bridge/config.py
@@ -21,6 +21,28 @@ def _required_int(name: str) -> int:
         raise ConfigError(f"{name} must be an integer Discord ID") from exc
 
 
+def _optional_role_ids() -> frozenset[int]:
+    raw = os.getenv("DISCORD_ROLE_IDS", "").strip()
+    if not raw:
+        return frozenset()
+
+    role_ids: set[int] = set()
+    for value in raw.split(","):
+        value = value.strip()
+        if not value or not value.isascii() or not value.isdigit():
+            raise ConfigError("DISCORD_ROLE_IDS must be a comma-separated list of Discord role IDs")
+        try:
+            role_id = int(value)
+        except ValueError as exc:
+            raise ConfigError(
+                "DISCORD_ROLE_IDS must be a comma-separated list of Discord role IDs"
+            ) from exc
+        if not 0 < role_id < 2**64:
+            raise ConfigError("DISCORD_ROLE_IDS contains an invalid Discord role ID")
+        role_ids.add(role_id)
+    return frozenset(role_ids)
+
+
