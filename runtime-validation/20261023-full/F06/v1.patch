+#!/bin/bash
+set -euo pipefail
+
+PROJECT_DIR="${BASH_SOURCE[0]%/*}"
+if [[ "$PROJECT_DIR" == "${BASH_SOURCE[0]}" ]]; then
+    PROJECT_DIR="."
+fi
+PROJECT_DIR="$(cd "$PROJECT_DIR" && pwd)"
+cd "$PROJECT_DIR"
+
+VENV_PYTHON="$PROJECT_DIR/.venv/bin/python"
+if [[ ! -x "$VENV_PYTHON" ]]; then
+    if ! command -v python3 >/dev/null 2>&1; then
+        message='Python 3.11 or newer is required. Install Python 3.11+ and try again.'
+        printf '%s\n' "$message" >&2
+        if command -v osascript >/dev/null 2>&1; then
+            osascript -e "display dialog \"$message\" with title \"Orca Discord Bridge\" buttons {\"OK\"} default button \"OK\"" >/dev/null 2>&1 || true
+        fi
+        exit 1
+    fi
+    python3 -m venv .venv
+    "$VENV_PYTHON" -m pip install .
+fi
+
+exec "$VENV_PYTHON" -m orca_discord_bridge
