+def test_start_command_missing_python_bootstrap(tmp_path):
+    launcher_source = Path(__file__).resolve().parents[1] / 'start.command'
+    message = 'Python 3.11 or newer is required. Install Python 3.11 or newer, then try again.'
+    secrets = ('OWNED_SYNTHETIC_TOKEN', 'OWNED_ENV_SECRET')
+
+    missing_project = tmp_path / 'missing-python-project'
+    missing_project.mkdir()
+    shutil.copyfile(launcher_source, missing_project / 'start.command')
+    missing_bin = tmp_path / 'missing-python-bin'
+    missing_bin.mkdir()
+    dialog_log = tmp_path / 'dialog.log'
+    (missing_bin / 'osascript').write_text(
+        '#!/bin/sh\nprintf \'%s\\n\' "$*" >> "$DIALOG_LOG"\n'
+    )
+    (missing_bin / 'osascript').chmod(0o700)
+    missing_env = {
+        'PATH': str(missing_bin),
+        'DIALOG_LOG': str(dialog_log),
+        'DISCORD_TOKEN': secrets[0],
+        'OWNED_ENV_SECRET': secrets[1],
+    }
+    missing = subprocess.run(
+        ['/bin/bash', './start.command'], cwd=missing_project, env=missing_env,
+        text=True, capture_output=True, check=False,
+    )
+    assert missing.returncode != 0
+    assert missing.stderr.strip() == message
+    assert missing.stdout == ''
+    assert message in dialog_log.read_text()
+    assert not (missing_project / '.venv').exists()
+    assert all(secret not in missing.stdout + missing.stderr for secret in secrets)
+
+    project = tmp_path / 'bootstrap-project'
+    project.mkdir()
+    shutil.copyfile(launcher_source, project / 'start.command')
+    fake_bin = tmp_path / 'fake-bin'
+    fake_bin.mkdir()
+    call_log = tmp_path / 'calls.log'
+    (fake_bin / 'python3').write_text(
+        '#!/bin/sh\n'
+        'printf \'python3:%s\\n\' "$*" >> "$CALL_LOG"\n'
+        'if [ "$#" -ne 3 ] || [ "$1" != -m ] || [ "$2" != venv ] || [ "$3" != .venv ]; then exit 91; fi\n'
+        '/bin/mkdir -p .venv/bin\n'
+        '/bin/cat > .venv/bin/python <<\'FAKE_PYTHON\'\n'
+        '#!/bin/sh\n'
+        'printf \'venv-python:%s\\n\' "$*" >> "$CALL_LOG"\n'
+        'FAKE_PYTHON\n'
+        '/bin/chmod 700 .venv/bin/python\n'
+    )
+    (fake_bin / 'python3').chmod(0o700)
+    project_env = {
+        'PATH': str(fake_bin),
+        'CALL_LOG': str(call_log),
+        'DISCORD_TOKEN': secrets[0],
+        'OWNED_ENV_SECRET': secrets[1],
+    }
+
+    first = subprocess.run(
+        ['/bin/bash', './start.command'], cwd=project, env=project_env,
+        text=True, capture_output=True, check=False,
+    )
+    assert first.returncode == 0, first.stderr
+    assert (project / '.venv/bin/python').is_file()
+    assert call_log.read_text().splitlines() == [
+        'python3:-m venv .venv',
+        'venv-python:-m pip install .',
+        'venv-python:-m orca_discord_bridge',
+    ]
+    assert all(secret not in first.stdout + first.stderr for secret in secrets)
+
+    (fake_bin / 'python3').unlink()
+    repeated = subprocess.run(
+        ['/bin/bash', './start.command'], cwd=project, env=project_env,
+        text=True, capture_output=True, check=False,
+    )
+    assert repeated.returncode == 0, repeated.stderr
+    assert call_log.read_text().splitlines() == [
+        'python3:-m venv .venv',
+        'venv-python:-m pip install .',
+        'venv-python:-m orca_discord_bridge',
+        'venv-python:-m orca_discord_bridge',
+    ]
+    assert all(secret not in repeated.stdout + repeated.stderr for secret in secrets)
