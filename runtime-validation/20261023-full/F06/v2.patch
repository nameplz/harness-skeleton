@@ -0,0 +1,27 @@
+#!/bin/bash
+set -e
+
+case "$0" in
+    */*) project_dir=${0%/*} ;;
+    *) project_dir=. ;;
+esac
+if [ -z "$project_dir" ]; then
+    project_dir=/
+fi
+cd "$project_dir"
+
+venv_python=.venv/bin/python
+if [ ! -x "$venv_python" ]; then
+    if ! command -v python3 >/dev/null 2>&1; then
+        message='Python 3.11 or newer is required. Install Python 3.11 or newer, then try again.'
+        printf '%s\n' "$message" >&2
+        if command -v osascript >/dev/null 2>&1; then
+            osascript -e "display dialog \"$message\" buttons {\"OK\"} default button \"OK\" with title \"Orca Discord Bridge\"" >/dev/null 2>&1 || true
+        fi
+        exit 1
+    fi
+    python3 -m venv .venv
+    "$venv_python" -m pip install .
+fi
+
+exec "$venv_python" -m orca_discord_bridge
