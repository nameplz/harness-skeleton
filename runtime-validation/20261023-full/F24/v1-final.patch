+def _safe_inline_identifier(value: str, *, limit: int = 80) -> str:
+    characters = []
+    for character in value[: limit * 4]:
+        category = unicodedata.category(character)
+        if category == "Cf":
+            continue
+        if category == "Cc" or character.isspace():
+            characters.append(" ")
+        else:
+            characters.append("'" if character == "`" else character)
+    cleaned = " ".join("".join(characters).split())
+    return cleaned[:limit] or "unknown"
+
