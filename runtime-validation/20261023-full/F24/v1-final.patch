+@orca_group.command(name="doctor", description="저장된 Orca 연결을 안전하게 진단합니다.")
+async def doctor_command(interaction: discord.Interaction) -> None:
+    bot = _bridge(interaction)
+    error = _auth_error(bot, guild_id=interaction.guild_id, user_id=interaction.user.id)
+    if error:
+        await interaction.response.send_message(error, ephemeral=True)
+        return
+
+    state = bot.store.state
+    saved_identity = (
+        state.terminal_handle,
+        state.worktree_id,
+        state.pane_key,
+    )
+    if not all(isinstance(value, str) and value.strip() for value in saved_identity):
+        await interaction.response.send_message(
+            "Orca terminal 연결이 없습니다. `/orca connect`로 다시 연결하세요.",
+            ephemeral=True,
+        )
+        return
+
+    handle, worktree_id, pane_key = (value.strip() for value in saved_identity)
+    await interaction.response.defer(ephemeral=True, thinking=True)
+    try:
+        binding = await bot.orca.resolve_binding(handle)
+        if binding.worktree_id != worktree_id or binding.pane_key != pane_key:
+            await interaction.followup.send(
+                "저장된 Orca 연결 정보가 변경되었습니다. `/orca connect`로 다시 연결하세요.",
+                ephemeral=True,
+            )
+            return
+        snapshot = await bot.orca.get_agent_snapshot(binding)
+    except OrcaError:
+        await interaction.followup.send(
+            "Orca 상태를 확인할 수 없습니다. terminal 상태를 확인한 뒤 `/orca connect`로 다시 연결하세요.",
+            ephemeral=True,
+        )
+        return
+
+    agent_state = "unknown"
+    if snapshot and isinstance(snapshot.state, str):
+        candidate_state = snapshot.state[:32].strip().casefold()
+        if candidate_state in {"working", "waiting", "blocked", "done"}:
+            agent_state = candidate_state
+    await interaction.followup.send(
+        "상태: 연결됨 (structured agent status 사용)\n"
+        f"Terminal: `{_safe_inline_identifier(binding.handle)}`\n"
+        f"Worktree: `{_safe_inline_identifier(binding.worktree_id)}`\n"
+        f"Pane: `{_safe_inline_identifier(binding.pane_key)}`\n"
+        f"Agent state: `{agent_state}`",
+        ephemeral=True,
+    )
+
+
