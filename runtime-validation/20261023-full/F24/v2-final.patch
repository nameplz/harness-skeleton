+@orca_group.command(name="doctor", description="Orca 연결과 terminal identity를 점검합니다.")
+async def doctor_command(interaction: discord.Interaction) -> None:
+    bot = _bridge(interaction)
+    error = _auth_error(bot, guild_id=interaction.guild_id, user_id=interaction.user.id)
+    if error:
+        await interaction.response.send_message(error, ephemeral=True)
+        return
+
+    state = bot.store.state
+    identity = (state.terminal_handle, state.worktree_id, state.pane_key)
+    if not all(isinstance(value, str) and value.strip() for value in identity):
+        await interaction.response.send_message(
+            "상태: 연결 끊김 (bridge disconnected). `/orca connect`로 다시 연결하세요.",
+            ephemeral=True,
+        )
+        return
+
+    handle = state.terminal_handle
+    await interaction.response.defer(ephemeral=True, thinking=True)
+    try:
+        binding = await bot.orca.resolve_binding(handle)
+        if (
+            binding.worktree_id != state.worktree_id
+            or binding.pane_key != state.pane_key
+        ):
+            await interaction.followup.send(
+                "상태: stale binding. Terminal identity가 변경되었습니다. "
+                "`/orca connect`로 다시 연결하세요.",
+                ephemeral=True,
+            )
+            return
+
+        snapshot = await bot.orca.get_agent_snapshot(binding)
+    except OrcaError:
+        await interaction.followup.send(
+            "Orca 상태를 확인하지 못했습니다. `/orca connect`로 다시 연결한 뒤 재시도하세요.",
+            ephemeral=True,
+        )
+        return
+
+    agent_state = getattr(snapshot, "state", None)
+    if not isinstance(agent_state, str) or not agent_state.strip():
+        agent_state = "unknown"
+    else:
+        agent_state = agent_state.strip()
+
+    await interaction.followup.send(
+        f"상태: 정상 (healthy)\n"
+        f"Terminal: `{handle}`\n"
+        f"Worktree: `{binding.worktree_id}`\n"
+        f"Pane: `{binding.pane_key}`\n"
+        f"Agent state: `{agent_state}`",
+        ephemeral=True,
+    )
+
+
