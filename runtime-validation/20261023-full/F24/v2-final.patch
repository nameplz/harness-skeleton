+def test_orca_doctor_reports_identity_and_stale_guidance(tmp_path):
+    async def run():
+        live = orca.TerminalBinding('term','wt','tab','leaf')
+
+        async def invoke(name, *, saved=('term','wt','tab:leaf'), binding=live,
+                         snapshot=None, error=None, snapshot_error=None, guild=1, user=2):
+            bot = bot_module.BridgeBot(settings(tmp_path/f'{name}.json'))
+            (bot.store.state.terminal_handle,
+             bot.store.state.worktree_id,
+             bot.store.state.pane_key) = saved
+            bot.orca = NS(
+                resolve_binding=AsyncMock(return_value=binding,side_effect=error),
+                get_agent_snapshot=AsyncMock(return_value=snapshot,side_effect=snapshot_error),
+            )
+            request = interaction(bot,guild=guild,user=user)
+            await bot_module.doctor_command.callback(request)
+            calls = (request.response.send_message.await_args_list
+                     + request.followup.send.await_args_list)
+            for call in calls:
+                assert call.kwargs.get('ephemeral') is True
+            for call in request.response.defer.await_args_list:
+                assert call.kwargs.get('ephemeral') is True
+            text = '\n'.join(call.args[0] for call in calls if call.args)
+            await bot.close()
+            return bot.orca, request, text
+
+        service, request, text = await invoke(
+            'healthy',snapshot=orca._parse_agent_snapshot(
+                row(state='working',message='OWNED_ASSISTANT_SECRET')))
+        assert 'healthy' in text and 'Terminal: `term`' in text
+        assert 'Worktree: `wt`' in text and 'Pane: `tab:leaf`' in text
+        assert 'Agent state: `working`' in text
+        service.resolve_binding.assert_awaited_once_with('term')
+        service.get_agent_snapshot.assert_awaited_once_with(live)
+        assert all(secret not in text for secret in (
+            'OWNED_SYNTHETIC_TOKEN','OWNED_ASSISTANT_SECRET','owned prompt',
+            'OWNED_TOOL_DETAIL','OWNED_TOOL_INPUT'))
+
+        for index, snapshot in enumerate((None,orca._parse_agent_snapshot(row(state='  ')))):
+            service, _, text = await invoke(f'unknown-{index}',snapshot=snapshot)
+            assert 'Agent state: `unknown`' in text
+            service.get_agent_snapshot.assert_awaited_once_with(live)
+
+        for name, binding in (
+            ('stale-worktree',orca.TerminalBinding('term','new-wt','tab','leaf')),
+            ('stale-pane',orca.TerminalBinding('term','wt','new-tab','leaf')),
+        ):
+            service, _, text = await invoke(name,binding=binding)
+            assert 'stale binding' in text and '`/orca connect`' in text
+            service.resolve_binding.assert_awaited_once_with('term')
+            service.get_agent_snapshot.assert_not_awaited()
+
+        for index, saved in enumerate((
+            (None,'wt','tab:leaf'),('term',None,'tab:leaf'),('term','wt',None),
+        )):
+            service, _, text = await invoke(f'missing-{index}',saved=saved)
+            assert '연결 끊김' in text and '`/orca connect`' in text
+            service.resolve_binding.assert_not_awaited()
+            service.get_agent_snapshot.assert_not_awaited()
+
+        for index, guild, user in ((0,7,2),(1,1,7)):
+            service, _, text = await invoke(f'unauthorized-{index}',guild=guild,user=user)
+            assert text
+            service.resolve_binding.assert_not_awaited()
+            service.get_agent_snapshot.assert_not_awaited()
+
+        for index, (error,snapshot_error) in enumerate((
+            (orca.OrcaError('OWNED_RAW_RESOLVE_ERROR'),None),
+            (None,orca.OrcaError('OWNED_RAW_SNAPSHOT_ERROR')),
+        )):
+            service, _, text = await invoke(
+                f'error-{index}',error=error,snapshot_error=snapshot_error)
+            assert '`/orca connect`' in text
+            assert 'OWNED_RAW_' not in text
+
+    asyncio.run(run())
+
+
