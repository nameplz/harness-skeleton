+def test_start_command_missing_python_bootstrap(tmp_path):
+    source = Path(__file__).resolve().parents[1] / 'start.command'
+    assert source.stat().st_mode & 0o111
+
+    project = tmp_path / 'project with spaces'
+    project.mkdir()
+    launcher = project / 'start.command'
+    shutil.copy2(source, launcher)
+    caller = tmp_path / 'caller directory'
+    caller.mkdir()
+
+    fake_bin = tmp_path / 'fake commands'
+    fake_bin.mkdir()
+    trace = tmp_path / 'launcher calls.log'
+    python3 = fake_bin / 'python3'
+    python3.write_text('''#!/bin/sh
+printf 'system:' >> "$CALL_LOG"
+printf '<%s>' "$@" >> "$CALL_LOG"
+printf '\\n' >> "$CALL_LOG"
+if [ "$1" = "-c" ]; then
+    exit 0
+fi
+if [ "$1" = "-m" ] && [ "$2" = "venv" ]; then
+    /bin/mkdir -p "$3/bin" || exit 1
+    /bin/cat > "$3/bin/python" <<'FAKE_PYTHON'
+#!/bin/sh
+printf 'venv:' >> "$CALL_LOG"
+printf '<%s>' "$@" >> "$CALL_LOG"
+printf '\\n' >> "$CALL_LOG"
+exit 0
+FAKE_PYTHON
+    /bin/chmod 755 "$3/bin/python"
+    exit $?
+fi
+exit 97
+''')
+    python3.chmod(0o755)
+
+    def environment(path):
+        return {
+            'PATH': str(path),
+            'CALL_LOG': str(trace),
+            'DISCORD_TOKEN': 'OWNED_SECRET_TOKEN',
+        }
+
+    first = subprocess.run(
+        [str(launcher)], cwd=caller, env=environment(fake_bin),
+        capture_output=True, text=True, check=False,
+    )
+    assert first.returncode == 0, first.stderr
+    assert (project / '.venv' / 'bin' / 'python').is_file()
+    first_calls = trace.read_text().splitlines()
+    assert any(call.startswith('system:<-c>') for call in first_calls)
+    assert any(call.startswith('system:<-m><venv><') for call in first_calls)
+    assert 'venv:<-m><pip><install><.>' in first_calls
+    assert 'venv:<-m><orca_discord_bridge>' in first_calls
+    assert 'OWNED_SECRET_TOKEN' not in first.stdout + first.stderr + trace.read_text()
+
+    before_repeat = len(first_calls)
+    repeat = subprocess.run(
+        [str(launcher)], cwd=caller, env=environment(tmp_path),
+        capture_output=True, text=True, check=False,
+    )
+    assert repeat.returncode == 0, repeat.stderr
+    repeat_calls = trace.read_text().splitlines()[before_repeat:]
+    assert repeat_calls == ['venv:<-m><orca_discord_bridge>']
+    assert 'OWNED_SECRET_TOKEN' not in repeat.stdout + repeat.stderr + trace.read_text()
+
+    trace_before_missing = trace.read_text()
+    missing_project = tmp_path / 'missing python project with spaces'
+    missing_project.mkdir()
+    missing_launcher = missing_project / 'start.command'
+    shutil.copy2(source, missing_launcher)
+    missing_bin = tmp_path / 'missing python commands'
+    missing_bin.mkdir()
+    dialog_log = tmp_path / 'osascript dialog.log'
+    osascript = missing_bin / 'osascript'
+    osascript.write_text('''#!/bin/sh
+printf '<%s>' "$@" >> "$DIALOG_LOG"
+printf '\\n' >> "$DIALOG_LOG"
+exit 0
+''')
+    osascript.chmod(0o755)
+    missing_env = environment(missing_bin)
+    missing_env['DIALOG_LOG'] = str(dialog_log)
+    missing = subprocess.run(
+        [str(missing_launcher)], cwd=caller, env=missing_env,
+        capture_output=True, text=True, check=False,
+    )
+    assert missing.returncode != 0
+    assert 'Python 3.11 or newer is required' in missing.stderr
+    assert 'Python 3.11 or newer is required' in dialog_log.read_text()
+    assert not (missing_project / '.venv').exists()
+    assert trace.read_text() == trace_before_missing
+    assert 'OWNED_SECRET_TOKEN' not in (
+        missing.stdout + missing.stderr + trace.read_text() + dialog_log.read_text()
+    )
