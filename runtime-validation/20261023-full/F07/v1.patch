@@ -0,0 +1,58 @@
+#!/bin/bash
+
+require_python() {
+    local message='Python 3.11 or newer is required. Install Python 3.11+ and try again.'
+    printf '%s\n' "$message" >&2
+    if command -v osascript >/dev/null 2>&1; then
+        osascript -e 'display dialog "Python 3.11 or newer is required. Install Python 3.11+ and try again." with title "Python required" buttons {"OK"} default button "OK"' >/dev/null 2>&1 || true
+    fi
+}
+
+script_path=${BASH_SOURCE[0]}
+case "$script_path" in
+    /*) ;;
+    */*) script_path="$PWD/$script_path" ;;
+    *)
+        script_path=$(command -v "$script_path" 2>/dev/null) || exit 1
+        case "$script_path" in
+            /*) ;;
+            *) script_path="$PWD/$script_path" ;;
+        esac
+        ;;
+esac
+
+project_dir=${script_path%/*}
+if [ "$project_dir" = "$script_path" ]; then
+    project_dir=$PWD
+fi
+PROJECT_DIR=$(CDPATH= cd -- "$project_dir" 2>/dev/null && pwd -P) || exit 1
+cd -- "$PROJECT_DIR" || exit 1
+
+VENV_DIR="$PROJECT_DIR/.venv"
+VENV_PYTHON="$VENV_DIR/bin/python"
+
+if [ -x "$VENV_PYTHON" ]; then
+    exec "$VENV_PYTHON" -m orca_discord_bridge
+fi
+
+if ! command -v python3 >/dev/null 2>&1; then
+    require_python
+    exit 1
+fi
+
+if ! python3 -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 11) else 1)' >/dev/null 2>&1; then
+    require_python
+    exit 1
+fi
+
+if ! python3 -m venv "$VENV_DIR"; then
+    printf '%s\n' 'Could not create the project virtual environment.' >&2
+    exit 1
+fi
+
+if ! "$VENV_PYTHON" -m pip install .; then
+    printf '%s\n' 'Could not install the project into its virtual environment.' >&2
+    exit 1
+fi
+
+exec "$VENV_PYTHON" -m orca_discord_bridge
