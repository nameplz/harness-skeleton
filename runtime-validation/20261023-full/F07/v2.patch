@@ -0,0 +1,22 @@
+#!/bin/bash
+set -e
+
+PROJECT_DIR="$(CDPATH= cd -- "$(dirname "$0")" && pwd)"
+VENV_DIR="$PROJECT_DIR/.venv"
+VENV_PYTHON="$VENV_DIR/bin/python"
+
+if [ ! -x "$VENV_PYTHON" ]; then
+    if ! command -v python3 >/dev/null 2>&1; then
+        PYTHON_REQUIRED='Python 3.11 or newer is required. Install Python 3.11+ and try again.'
+        printf '%s\n' "$PYTHON_REQUIRED" >&2
+        if command -v osascript >/dev/null 2>&1; then
+            osascript -e 'display dialog "Python 3.11 or newer is required. Install Python 3.11+ and try again." buttons {"OK"} default button "OK" with title "Orca Discord Bridge"'
+        fi
+        exit 1
+    fi
+
+    python3 -m venv "$VENV_DIR"
+    "$VENV_PYTHON" -m pip install "$PROJECT_DIR"
+fi
+
+exec "$VENV_PYTHON" -m orca_discord_bridge
