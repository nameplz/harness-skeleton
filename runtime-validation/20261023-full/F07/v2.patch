+def test_start_command_missing_python_bootstrap(tmp_path):
+    source = Path(__file__).resolve().parents[1] / 'start.command'
+
+    def make_project(name):
+        project = tmp_path / name
+        project.mkdir()
+        launcher = project / 'start.command'
+        launcher.write_text(source.read_text())
+        launcher.chmod(0o755)
+        return project, launcher
+
+    def write_command(directory, name, body):
+        path = directory / name
+        path.write_text('#!/bin/sh\n' + body)
+        path.chmod(0o755)
+        return path
+
+    def log_command(label):
+        return "{ printf '" + label + "'; for arg do printf '\\t%s' \"$arg\"; done; printf '\\n'; } >> \"$FAKE_LOG\"\n"
+
+    first_commands = tmp_path / 'commands with python'
+    first_commands.mkdir()
+    write_command(first_commands, 'dirname', 'printf \'%s\\n\' "${1%/*}"\n')
+    write_command(
+        first_commands,
+        'python3',
+        log_command('python3')
+        + 'if [ "$#" -ne 3 ] || [ "$1" != "-m" ] || [ "$2" != "venv" ]; then exit 90; fi\n'
+        + '/bin/mkdir -p "$3/bin"\n'
+        + "/bin/cat > \"$3/bin/python\" <<'SH'\n"
+        + '#!/bin/sh\n'
+        + log_command('venv-python')
+        + 'SH\n'
+        + '/bin/chmod +x "$3/bin/python"\n',
+    )
+    project, launcher = make_project('bridge project with spaces')
+    venv = project / '.venv'
+    log = tmp_path / 'fake-command.log'
+    secret = 'OWNED_SYNTHETIC_DISCORD_TOKEN'
+
+    def run(launcher, command_path):
+        env = {
+            'PATH': str(command_path),
+            'FAKE_LOG': str(log),
+            'DISCORD_TOKEN': secret,
+        }
+        return subprocess.run(
+            [str(launcher)], cwd=tmp_path, env=env, capture_output=True, text=True, check=False
+        )
+
+    log.write_text('')
+    first = run(launcher, first_commands)
+    assert first.returncode == 0, first.stderr
+    assert log.read_text().splitlines() == [
+        f'python3\t-m\tvenv\t{venv}',
+        f'venv-python\t-m\tpip\tinstall\t{project}',
+        'venv-python\t-m\torca_discord_bridge',
+    ]
+    assert secret not in first.stdout + first.stderr + log.read_text()
+
+    repeat_commands = tmp_path / 'commands without python'
+    repeat_commands.mkdir()
+    write_command(repeat_commands, 'dirname', 'printf \'%s\\n\' "${1%/*}"\n')
+    log.write_text('')
+    repeat = run(launcher, repeat_commands)
+    assert repeat.returncode == 0, repeat.stderr
+    assert log.read_text().splitlines() == ['venv-python\t-m\torca_discord_bridge']
+    assert secret not in repeat.stdout + repeat.stderr + log.read_text()
+
+    missing_commands = tmp_path / 'commands with dialog only'
+    missing_commands.mkdir()
+    write_command(missing_commands, 'dirname', 'printf \'%s\\n\' "${1%/*}"\n')
+    write_command(missing_commands, 'osascript', log_command('osascript'))
+    missing_project, missing_launcher = make_project('project without python')
+    log.write_text('')
+    missing = run(missing_launcher, missing_commands)
+    assert missing.returncode != 0
+    assert 'Python 3.11' in missing.stderr and 'required' in missing.stderr
+    assert not (missing_project / '.venv').exists()
+    missing_log = log.read_text()
+    assert len(missing_log.splitlines()) == 1
+    assert missing_log.startswith('osascript\t-e\tdisplay dialog "Python 3.11 or newer is required.')
+    assert secret not in missing.stdout + missing.stderr + missing_log
