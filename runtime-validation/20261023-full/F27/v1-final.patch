+def test_forward_revalidates_stale_binding_before_exchange(tmp_path):
+    class Channel(bot_module.discord.TextChannel):
+        def __init__(self): self.sent=[]
+        async def send(self, value): self.sent.append(value)
+
+    async def exercise(case, saved_worktree, saved_pane, live_binding, validation_error=None):
+        path=tmp_path/case/'state.json'
+        bot=bot_module.BridgeBot(settings(path))
+        bot.store.connect('term', saved_worktree or 'old-worktree', saved_pane or 'old-pane')
+        if saved_worktree is None or saved_pane is None:
+            bot.store.state.worktree_id=saved_worktree
+            bot.store.state.pane_key=saved_pane
+            bot.store.save()
+        saved_before=json.loads(path.read_text())
+        state_before=(bot.store.state.terminal_handle, bot.store.state.worktree_id, bot.store.state.pane_key)
+        validated=orca.TerminalBinding('term','validated-worktree','validated-tab','validated-leaf')
+        calls=[]
+        async def resolve(handle):
+            calls.append(('resolve',handle))
+            return live_binding
+        async def validate(handle):
+            calls.append(('validate',handle))
+            if validation_error:
+                raise validation_error
+            return validated
+        async def exchange(binding, prompt):
+            calls.append(('exchange',binding,prompt))
+            return orca.ExchangeResult('owned response','done')
+        bot.orca=NS(
+            resolve_binding=AsyncMock(side_effect=resolve),
+            validate_codex_binding=AsyncMock(side_effect=validate),
+            exchange=AsyncMock(side_effect=exchange),
+        )
+        channel=Channel();bot.get_channel=lambda _:channel
+
+        if validation_error:
+            with pytest.raises(orca.OrcaError, match='validation failed'):
+                await bot.forward_to_codex('owned prompt',origin='owned')
+            bot.orca.exchange.assert_not_awaited()
+            assert (bot.store.state.terminal_handle, bot.store.state.worktree_id, bot.store.state.pane_key)==state_before
+            assert json.loads(path.read_text())==saved_before
+            bot.orca.validate_codex_binding.assert_awaited_once_with('term')
+            assert channel.sent==[]
+            assert calls==[('resolve','term'),('validate','term')]
+        else:
+            await bot.forward_to_codex('owned prompt',origin='owned')
+            if case=='unchanged':
+                bot.orca.validate_codex_binding.assert_not_awaited()
+                bot.orca.exchange.assert_awaited_once_with(live_binding,'owned prompt')
+                assert json.loads(path.read_text())==saved_before
+                assert (bot.store.state.terminal_handle, bot.store.state.worktree_id, bot.store.state.pane_key)==state_before
+                assert calls==[('resolve','term'),('exchange',live_binding,'owned prompt')]
+            else:
+                bot.orca.validate_codex_binding.assert_awaited_once_with('term')
+                bot.orca.exchange.assert_awaited_once_with(validated,'owned prompt')
+                assert json.loads(path.read_text())=={
+                    'terminal_handle':'term',
+                    'worktree_id':'validated-worktree',
+                    'pane_key':'validated-tab:validated-leaf',
+                }
+                assert (bot.store.state.terminal_handle, bot.store.state.worktree_id, bot.store.state.pane_key)==(
+                    'term','validated-worktree','validated-tab:validated-leaf'
+                )
+                assert calls==[('resolve','term'),('validate','term'),('exchange',validated,'owned prompt')]
+            assert channel.sent==['owned response']
+
+        bot.orca.resolve_binding.assert_awaited_once_with('term')
+        await bot.close()
+
+    async def run():
+        await exercise('pane-drift','wt','tab:old-leaf',orca.TerminalBinding('term','wt','tab','leaf'))
+        await exercise('worktree-drift','old-wt','tab:leaf',orca.TerminalBinding('term','wt','tab','leaf'))
+        await exercise('incomplete','wt',None,orca.TerminalBinding('term','wt','tab','leaf'))
+        await exercise('unchanged','wt','tab:leaf',orca.TerminalBinding('term','wt','tab','leaf'))
+        await exercise(
+            'failed-validation','old-wt','tab:leaf',orca.TerminalBinding('term','wt','tab','leaf'),
+            validation_error=orca.OrcaError('validation failed'),
+        )
+
+    asyncio.run(run())
+
+
 def test_state_roundtrip_and_malformed_json(tmp_path):
     path=tmp_path/'owned/state.json';store=StateStore(path)
     assert store.state.terminal_handle is None
