+def test_orca_doctor_reports_identity_and_stale_guidance(tmp_path):
+    async def run():
+        bot = bot_module.BridgeBot(settings(tmp_path/'state.json'))
+        bot.store.connect('term', 'wt', 'tab:leaf')
+        matching = orca.TerminalBinding('term', 'wt', 'tab', 'leaf')
+        snapshot = NS(
+            state='done',
+            prompt='OWNED_DOCTOR_PROMPT',
+            last_assistant_message='OWNED_DOCTOR_ASSISTANT',
+            tool_input='OWNED_DOCTOR_TOOL_INPUT',
+        )
+        bot.orca = NS(
+            resolve_binding=AsyncMock(return_value=matching),
+            get_agent_snapshot=AsyncMock(return_value=snapshot),
+        )
+
+        def text(request):
+            sender = request.followup.send if request.followup.send.await_count else request.response.send_message
+            return sender.call_args.args[0]
+
+        def assert_private(request):
+            senders = (request.response.send_message, request.response.defer, request.followup.send)
+            for sender in senders:
+                for call in sender.await_args_list:
+                    assert call.kwargs.get('ephemeral') is True
+
+        healthy = interaction(bot)
+        await bot_module.doctor_command.callback(healthy)
+        healthy_text = text(healthy)
+        assert all(value in healthy_text for value in ('term', 'wt', 'tab:leaf', 'done'))
+        assert '정상' in healthy_text
+        bot.orca.resolve_binding.assert_awaited_once_with('term')
+        bot.orca.get_agent_snapshot.assert_awaited_once_with(matching)
+        assert_private(healthy)
+        for secret in (
+            bot.settings.discord_token,
+            'OWNED_DOCTOR_PROMPT',
+            'OWNED_DOCTOR_ASSISTANT',
+            'OWNED_DOCTOR_TOOL_INPUT',
+        ):
+            assert secret not in healthy_text
+
+        bot.orca.resolve_binding.reset_mock()
+        bot.orca.get_agent_snapshot.reset_mock()
+        bot.orca.get_agent_snapshot.return_value = None
+        unknown = interaction(bot)
+        await bot_module.doctor_command.callback(unknown)
+        assert 'unknown' in text(unknown)
+        bot.orca.get_agent_snapshot.assert_awaited_once_with(matching)
+        assert_private(unknown)
+
+        for stale in (
+            orca.TerminalBinding('term', 'new-wt', 'tab', 'leaf'),
+            orca.TerminalBinding('term', 'wt', 'tab', 'new-leaf'),
+        ):
+            bot.orca.resolve_binding.reset_mock()
+            bot.orca.get_agent_snapshot.reset_mock()
+            bot.orca.resolve_binding.return_value = stale
+            request = interaction(bot)
+            await bot_module.doctor_command.callback(request)
+            stale_text = text(request)
+            assert 'stale' in stale_text
+            assert '/orca connect' in stale_text
+            bot.orca.get_agent_snapshot.assert_not_awaited()
+            assert_private(request)
+
+        bot.orca.resolve_binding.reset_mock()
+        bot.orca.get_agent_snapshot.reset_mock()
+        for field in ('terminal_handle', 'worktree_id', 'pane_key'):
+            original = getattr(bot.store.state, field)
+            setattr(bot.store.state, field, None)
+            request = interaction(bot)
+            await bot_module.doctor_command.callback(request)
+            assert '끊겨' in text(request)
+            assert '/orca connect' in text(request)
+            bot.orca.resolve_binding.assert_not_awaited()
+            bot.orca.get_agent_snapshot.assert_not_awaited()
+            assert_private(request)
+            setattr(bot.store.state, field, original)
+
+        for request in (interaction(bot, guild=99), interaction(bot, user=99)):
+            bot.orca.resolve_binding.reset_mock()
+            bot.orca.get_agent_snapshot.reset_mock()
+            await bot_module.doctor_command.callback(request)
+            bot.orca.resolve_binding.assert_not_awaited()
+            bot.orca.get_agent_snapshot.assert_not_awaited()
+            assert_private(request)
+
+        bot.orca.resolve_binding.reset_mock()
+        bot.orca.get_agent_snapshot.reset_mock()
+        bot.orca.resolve_binding.side_effect = orca.OrcaError('OWNED_VALIDATION_DETAIL')
+        failed = interaction(bot)
+        await bot_module.doctor_command.callback(failed)
+        assert '/orca connect' in text(failed)
+        assert 'OWNED_VALIDATION_DETAIL' not in text(failed)
+        bot.orca.get_agent_snapshot.assert_not_awaited()
+        assert_private(failed)
+        await bot.close()
+    asyncio.run(run())
+
+
