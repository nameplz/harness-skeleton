+@orca_group.command(name="doctor", description="저장된 Orca 연결 상태와 복구 방법을 확인합니다.")
+async def doctor_command(interaction: discord.Interaction) -> None:
+    bot = _bridge(interaction)
+    error = _auth_error(bot, guild_id=interaction.guild_id, user_id=interaction.user.id)
+    if error:
+        await interaction.response.send_message(error, ephemeral=True)
+        return
+
+    saved = bot.store.state
+    handle = saved.terminal_handle
+    worktree_id = saved.worktree_id
+    pane_key = saved.pane_key
+    if not handle or not worktree_id or not pane_key:
+        await interaction.response.send_message(
+            "Orca bridge 연결이 끊겨 있습니다. `/orca connect`로 다시 연결하세요.",
+            ephemeral=True,
+        )
+        return
+
+    await interaction.response.defer(ephemeral=True, thinking=True)
+    try:
+        binding = await bot.orca.resolve_binding(handle)
+        changed = []
+        if binding.worktree_id != worktree_id:
+            changed.append("worktree")
+        if binding.pane_key != pane_key:
+            changed.append("pane")
+        if changed:
+            details = ", ".join(changed)
+            await interaction.followup.send(
+                f"저장된 Orca binding이 stale 상태입니다 ({details} identity가 변경됨). "
+                "`/orca connect`로 다시 연결하세요.",
+                ephemeral=True,
+            )
+            return
+
+        snapshot = await bot.orca.get_agent_snapshot(binding)
+    except OrcaError:
+        await interaction.followup.send(
+            "Orca 연결 상태를 확인하지 못했습니다. `/orca connect`로 다시 연결하세요.",
+            ephemeral=True,
+        )
+        return
+
+    agent_state = getattr(snapshot, "state", "") if snapshot is not None else ""
+    if not isinstance(agent_state, str) or not agent_state.strip():
+        agent_state = "unknown"
+    await interaction.followup.send(
+        "상태: 정상 (structured agent status 사용)\n"
+        f"Terminal: `{binding.handle}`\n"
+        f"Worktree: `{binding.worktree_id}`\n"
+        f"Pane: `{binding.pane_key}`\n"
+        f"Agent state: `{agent_state}`",
+        ephemeral=True,
+    )
+
+
