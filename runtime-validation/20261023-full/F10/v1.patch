+@orca_group.command(name="doctor", description="저장된 Orca 연결과 agent 상태를 진단합니다.")
+async def doctor_command(interaction: discord.Interaction) -> None:
+    bot = _bridge(interaction)
+    error = _auth_error(bot, guild_id=interaction.guild_id, user_id=interaction.user.id)
+    if error:
+        await interaction.response.send_message(error, ephemeral=True)
+        return
+
+    await interaction.response.defer(ephemeral=True, thinking=True)
+    handle = bot.store.state.terminal_handle
+    worktree_id = bot.store.state.worktree_id
+    pane_key = bot.store.state.pane_key
+    if not handle or not worktree_id or not pane_key:
+        await interaction.followup.send(
+            "상태: 연결되지 않음 — 저장된 Orca binding이 없습니다. `/orca connect`로 연결하세요.",
+            ephemeral=True,
+        )
+        return
+
+    try:
+        # Resolve the saved handle without asking for agent state yet. A moved terminal
+        # must not cause us to inspect the agent attached to its new worktree or pane.
+        binding = await bot.orca.resolve_binding(handle)
+    except OrcaError:
+        await interaction.followup.send(
+            "상태: terminal 확인 실패 — `/orca connect`로 Orca 연결을 다시 설정하세요.",
+            ephemeral=True,
+        )
+        return
+
+    if binding.worktree_id != worktree_id or binding.pane_key != pane_key:
+        await interaction.followup.send(
+            "상태: stale — 저장된 Orca binding이 현재 terminal identity와 다릅니다. "
+            "`/orca connect`로 다시 연결하세요.",
+            ephemeral=True,
+        )
+        return
+
+    try:
+        snapshot = await bot.orca.get_agent_snapshot(binding)
+    except OrcaError:
+        await interaction.followup.send(
+            "상태: agent state 확인 실패 — `/orca connect`로 Orca 연결을 다시 설정하세요.",
+            ephemeral=True,
+        )
+        return
+
+    agent_state = getattr(snapshot, "state", None) if snapshot is not None else None
+    if not isinstance(agent_state, str) or agent_state not in {
+        "working",
+        "waiting",
+        "blocked",
+        "done",
+    }:
+        agent_state = "unknown"
+    await interaction.followup.send(
+        "상태: 연결됨 (structured agent status 사용)\n"
+        f"Terminal: `{handle}`\n"
+        f"Worktree: `{worktree_id}`\n"
+        f"Pane: `{pane_key}`\n"
+        f"Agent state: `{agent_state}`",
+        ephemeral=True,
+    )
+
+
