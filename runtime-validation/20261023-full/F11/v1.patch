+def test_unresolved_reply_is_fetched_once_and_forwarded(tmp_path, monkeypatch):
+    @asynccontextmanager
+    async def typing():
+        yield
+
+    class LocalDiscordMessage:
+        def __init__(self, content, embeds=()):
+            self.content = content
+            self.embeds = list(embeds)
+
+    async def run():
+        bot = bot_module.BridgeBot(settings(tmp_path / 'state.json'))
+        monkeypatch.setattr(bot_module.discord, 'Message', LocalDiscordMessage)
+        bot.store.connect('term', 'wt', 'tab:leaf')
+        bot.forward_to_codex = AsyncMock()
+
+        fetched = LocalDiscordMessage('fetched reference content')
+        channel = NS(
+            id=3,
+            typing=typing,
+            fetch_message=AsyncMock(return_value=fetched),
+        )
+        message = NS(
+            author=NS(id=2, bot=False),
+            webhook_id=None,
+            guild=NS(id=1),
+            channel=channel,
+            content='summarize this reference',
+            reference=NS(message_id=41, resolved=None),
+            id=9,
+        )
+
+        await bot.on_message(message)
+
+        channel.fetch_message.assert_awaited_once_with(41)
+        bot.forward_to_codex.assert_awaited_once()
+        prompt = bot.forward_to_codex.call_args.args[0]
+        assert 'fetched reference content' in prompt
+        assert 'summarize this reference' in prompt
+        assert '--- End referenced message ---' in prompt
+        await bot.close()
+
+    asyncio.run(run())
+
