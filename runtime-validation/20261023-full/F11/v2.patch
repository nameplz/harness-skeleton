+def test_unresolved_reply_is_fetched_once_and_forwarded(tmp_path, monkeypatch):
+    class Message:
+        pass
+
+    monkeypatch.setattr(bot_module.discord, 'Message', Message)
+
+    @asynccontextmanager
+    async def typing():
+        yield
+
+    async def run():
+        bot = bot_module.BridgeBot(settings(tmp_path / 'state.json'))
+        bot.store.connect('term', 'wt', 'tab:leaf')
+        bot.forward_to_codex = AsyncMock()
+
+        referenced = Message()
+        referenced.content = 'fetched reference content'
+        referenced.embeds = []
+        fetch_message = AsyncMock(return_value=referenced)
+        channel = NS(id=3, typing=typing, fetch_message=fetch_message)
+        message = NS(
+            author=NS(id=2, bot=False), webhook_id=None, guild=NS(id=1),
+            channel=channel, content='review this',
+            reference=NS(message_id=44, resolved=None), id=5,
+        )
+
+        await bot.on_message(message)
+
+        fetch_message.assert_awaited_once_with(44)
+        bot.forward_to_codex.assert_awaited_once_with(
+            formatting.replied_message_prompt(referenced, 'review this'),
+            origin='Discord message 5',
+        )
+        prompt = bot.forward_to_codex.await_args.args[0]
+        assert 'fetched reference content' in prompt
+        assert '<<< BEGIN REFERENCED DISCORD MESSAGE >>>' in prompt
+        assert '<<< END REFERENCED DISCORD MESSAGE >>>' in prompt
+        await bot.close()
+
+    asyncio.run(run())
+
+
