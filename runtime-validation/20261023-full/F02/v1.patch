@@ -21,6 +21,23 @@ def _required_int(name: str) -> int:
         raise ConfigError(f"{name} must be an integer Discord ID") from exc
 
 
+def _optional_int_ids(name: str) -> frozenset[int]:
+    raw = os.getenv(name, "")
+    ids: set[int] = set()
+    for entry in raw.split(","):
+        value = entry.strip()
+        if not value:
+            continue
+        try:
+            ids.add(int(value))
+        except ValueError as exc:
+            raise ConfigError(
+                f"{name} must be a comma-separated list of integer Discord IDs "
+                f"(invalid entry: {value!r})"
+            ) from exc
+    return frozenset(ids)
+
+
