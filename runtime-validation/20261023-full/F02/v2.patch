@@ -21,6 +21,23 @@ def _required_int(name: str) -> int:
         raise ConfigError(f"{name} must be an integer Discord ID") from exc
 
 
+def _optional_int_list(name: str) -> tuple[int, ...]:
+    values: list[int] = []
+    seen: set[int] = set()
+    for entry in os.getenv(name, "").split(","):
+        entry = entry.strip()
+        if not entry:
+            continue
+        try:
+            value = int(entry)
+        except ValueError as exc:
+            raise ConfigError(f"{name} entries must be integer Discord IDs") from exc
+        if value not in seen:
+            values.append(value)
+            seen.add(value)
+    return tuple(values)
+
