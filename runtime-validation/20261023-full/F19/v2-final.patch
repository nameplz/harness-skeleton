+def test_state_missing_file_valid_object_and_roundtrip(tmp_path):
+    path = tmp_path / 'owned/state.json'
+    store = StateStore(path)
+    assert store.state == BridgeState()
+    assert not path.exists()
+
+    valid_state = BridgeState('saved-term', 'saved-worktree', 'saved-tab:saved-leaf')
+    path.parent.mkdir(parents=True)
+    path.write_text(json.dumps({
+        'terminal_handle': valid_state.terminal_handle,
+        'worktree_id': valid_state.worktree_id,
+        'pane_key': valid_state.pane_key,
+    }), encoding='utf-8')
+    assert StateStore(path).state == valid_state
+
+    store.connect('term', 'wt', 'tab:leaf')
+    assert StateStore(path).state == BridgeState('term', 'wt', 'tab:leaf')
+    store.disconnect()
+    assert StateStore(path).state == BridgeState()
+
+
+@pytest.mark.parametrize('invalid_bytes', [
+    pytest.param(b'', id='empty-file'),
+    pytest.param(b' \t\r\n', id='whitespace-only'),
+    pytest.param(b'{"terminal_handle":', id='truncated-json'),
+    pytest.param(b'{"terminal_handle":null}garbage', id='trailing-garbage'),
+    pytest.param(b'\xff', id='invalid-utf8'),
+])
+def test_state_malformed_bytes_load_empty_without_rewriting(tmp_path, invalid_bytes):
+    path = tmp_path / 'owned/state.json'
+    path.parent.mkdir(parents=True)
+    path.write_bytes(invalid_bytes)
+
+    assert StateStore(path).state == BridgeState()
+    assert path.read_bytes() == invalid_bytes
+
+
+@pytest.mark.parametrize('json_root', [
