+def test_filter_assistant_output_handles_size_boundaries():
+    forty_five_lines = "\n".join(f"kept-line-{index}" for index in range(45))
+    forty_six_lines = "\n".join(f"dropped-line-{index}" for index in range(46))
+    shell_commands = "\n".join(f"echo command-{index}" for index in range(46))
+    rename_diff = "\n".join(
+        [
+            "diff --git a/old.txt b/new.txt",
+            "similarity index 100%",
+            "rename from old.txt",
+            "rename to new.txt",
+            "index 1234567..abcdef0 100644",
+            "--- a/old.txt",
+            "+++ b/new.txt",
+            "@@ -1,3 +1,3 @@",
+            " unchanged context line",
+            " ",
+            "-old line",
+            "+new line",
+        ]
+    )
+    binary_diff = "\n".join(
+        [
+            "diff --git a/image.bin b/image.bin",
+            "index 0000000..1234567",
+            "GIT binary patch",
+            "literal 12",
+            "zcmV?d000001",
+        ]
+    )
+    deleted_diff = "\n".join(
+        [
+            "diff --git a/removed.txt b/removed.txt",
+            "deleted file mode 100644",
+            "index 1234567..0000000",
+            "--- a/removed.txt",
+            "+++ /dev/null",
+            "@@ -1 +0,0 @@",
+            "-removed line",
+        ]
+    )
+    final_diff = "\n".join(
+        [
+            "diff --git a/example.py b/example.py",
+            "new file mode 100644",
+            "index 0000000..abcdef0",
+            "--- /dev/null",
+            "+++ b/example.py",
+            "@@ -0,0 +1 @@",
+            "+new = True",
+        ]
+    )
+    text = (
+        "Prose stays visible.\n\n"
+        "```python\nprint('short example')\n```\n\n"
+        f"```python\n{'a' * 2_400}\n```\n\n"
+        f"```python\n{'b' * 2_401}\n```\n\n"
+        f"```python\n{forty_five_lines}\n```\n\n"
+        f"```python\n{forty_six_lines}\n```\n\n"
+        f"```bash\n{shell_commands}\n```\n\n"
+        f"{rename_diff}\nProse after the diff.\n\n"
+        f"{binary_diff}\n\nProse after the binary patch.\n\n"
+        f"{deleted_diff}\n\nProse before the final diff.\n\n{final_diff}"
+    )
+
+    result = _filter_assistant_output(text)
+
+    assert "Prose stays visible." in result
+    assert "print('short example')" in result
+    assert "a" * 2_400 in result
+    assert "b" * 2_401 not in result
+    for index in range(45):
+        assert f"kept-line-{index}" in result
+    for index in range(46):
+        assert f"dropped-line-{index}" not in result
+        assert f"echo command-{index}" in result
+    assert result.count("_(긴 코드 블록 생략)_") == 2
+    assert "Prose after the diff." in result
+    assert "Prose after the binary patch." in result
+    assert "Prose before the final diff." in result
+    assert "similarity index 100%" not in result
+    assert "rename from old.txt" not in result
+    assert "rename to new.txt" not in result
+    assert "new file mode 100644" not in result
+    assert "deleted file mode 100644" not in result
+    assert "unchanged context line" not in result
+    assert "old line" not in result
+    assert "new line" not in result
+    assert "removed line" not in result
+    assert "GIT binary patch" not in result
+    assert "literal 12" not in result
+    assert "zcmV?d000001" not in result
+    assert result.count("_(diff/patch 상세 생략)_") == 4
+    assert result.endswith("_(diff/patch 상세 생략)_")
+
+
+def test_local_markdown_links_with_spaces_and_external_links():
+    text = (
+        "[Release notes](/Users/me/project/docs/Release Notes.md:27) and "
+        "[guide](https://example.com/docs/guide.html?view=full)"
+    )
+
+    result = _filter_assistant_output(text, "/Users/me/project")
+
+    assert result == (
+        "Release notes (`docs/Release Notes.md:27`) and "
+        "[guide](https://example.com/docs/guide.html?view=full)"
+    )
+
