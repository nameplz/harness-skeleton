+def test_filter_assistant_output_handles_size_boundaries():
+    long_python = "\n".join(f"value_{index} = {index}" for index in range(46))
+    long_shell = "\n".join(f"echo step-{index}" for index in range(46))
+    text = (
+        "Prose stays visible.\n\n"
+        "```python\nprint('short example')\n```\n\n"
+        f"```python\n{long_python}\n```\n\n"
+        f"```bash\n{long_shell}\n```\n\n"
+        "diff --git a/example.py b/example.py\n"
+        "index 1234567..89abcde 100644\n"
+        "--- a/example.py\n"
+        "+++ b/example.py\n"
+        "@@ -1 +1 @@\n"
+        "-old_value = False\n"
+        "+new_value = True"
+    )
+
+    result = _filter_assistant_output(text)
+
+    assert "Prose stays visible." in result
+    assert "print('short example')" in result
+    assert "_(긴 코드 블록 생략)_" in result
+    assert "value_0 = 0" not in result
+    assert "echo step-0" in result
+    assert "echo step-45" in result
+    assert result.endswith("_(diff/patch 상세 생략)_")
+    assert "diff --git" not in result
+    assert "+new_value = True" not in result
+
+
+def test_local_markdown_links_with_spaces_and_external_links():
+    text = (
+        "[developer guide](/Users/me/project/docs/Developer Guide.md:37) "
+        "and [upstream docs](https://example.com/docs)"
+    )
+
+    result = _filter_assistant_output(text, "/Users/me/project")
+
+    assert result == (
+        "developer guide (`docs/Developer Guide.md:37`) and "
+        "[upstream docs](https://example.com/docs)"
+    )
+
