+def test_state_file_is_private_for_new_and_replaced_files(tmp_path):
+    path=tmp_path/'owned/nested/state.json';store=StateStore(path)
+    original_umask=os.umask(0)
+    try:
+        store.connect('term','wt','tab:leaf')
+        assert path.stat().st_mode & 0o777 == 0o600
+        path.chmod(0o644)
+        store.state.pane_key='tab:other'
+        store.save()
+        assert path.stat().st_mode & 0o777 == 0o600
+        assert StateStore(path).state.pane_key=='tab:other'
+    finally:
+        os.umask(original_umask)
+
