diff --git a/tests/test_harness_compatibility.py b/tests/test_harness_compatibility.py
index e476a1a..95e0a4c 100644
--- a/tests/test_harness_compatibility.py
+++ b/tests/test_harness_compatibility.py
@@ -172,0 +173,96 @@ def test_discord_message_boundary(tmp_path, change):
+def test_denied_events_do_not_call_orca(tmp_path):
+    async def run():
+        bot = bot_module.BridgeBot(settings(tmp_path / 'denied-state.json'))
+        bot._connection.user = NS(id=99)
+        binding = orca.TerminalBinding('term', 'wt', 'tab', 'leaf')
+        orca_spies = {
+            'list_terminals': AsyncMock(return_value=[]),
+            'validate_codex_binding': AsyncMock(return_value=binding),
+            'get_agent_snapshot': AsyncMock(return_value=None),
+            'resolve_binding': AsyncMock(return_value=binding),
+            'exchange': AsyncMock(return_value=orca.ExchangeResult('', 'done', False)),
+        }
+        bot.orca = NS(**orca_spies)
+        bot.forward_to_codex = AsyncMock()
+        bot.store.connect('term', 'wt', 'tab:leaf')
+
+        class SyntheticMessage:
+            def __init__(self, *, guild_id=1, user_id=2, channel_id=3,
+                         author_is_bot=False, webhook_id=None, content='owned prompt'):
+                self.author = NS(id=user_id, bot=author_is_bot)
+                self.webhook_id = webhook_id
+                self.guild = NS(id=guild_id) if guild_id is not None else None
+                self.channel = NS(id=channel_id)
+                self._content = content
+                self.reference = None
+                self.id = 4
+                self.reply = AsyncMock()
+
+            @property
+            def content(self):
+                if self.guild is None:
+                    raise AssertionError('DM content was inspected before authorization')
+                return self._content
+
+        denied_messages = (
+            SyntheticMessage(guild_id=None),  # DM, even for the configured user
+            SyntheticMessage(guild_id=7),     # wrong guild
+            SyntheticMessage(user_id=7),      # wrong user
+            SyntheticMessage(channel_id=7),   # wrong channel
+            SyntheticMessage(author_is_bot=True),
+            SyntheticMessage(webhook_id=8),
+            SyntheticMessage(user_id=99),     # this bot's own message
+            SyntheticMessage(content='  '),   # empty input
+        )
+        for message in denied_messages:
+            await bot.on_message(message)
+
+        for name in ('terminals_command', 'connect_command', 'status_command', 'disconnect_command'):
+            request = interaction(bot, guild=7)
+            args = (request, 'term') if name == 'connect_command' else (request,)
+            await getattr(bot_module, name).callback(*args)
+            request.response.send_message.assert_awaited_once()
+
+        source = NS(content='owned context', embeds=[])
+        for guild_id, user_id in ((7, 2), (1, 7)):
+            request = interaction(bot, guild=guild_id, user=user_id)
+            await bot_module.send_to_codex_context.callback(request, source)
+            request.response.send_modal.assert_not_awaited()
+
+        modal = bot_module.ForwardModal(bot, source)
+        for guild_id, user_id in ((7, 2), (1, 7)):
+            request = interaction(bot, guild=guild_id, user=user_id)
+            await modal.on_submit(request)
+            request.response.send_message.assert_awaited_once()
+
+        bot.forward_to_codex.assert_not_awaited()
+        for spy in orca_spies.values():
+            spy.assert_not_awaited()
+        await bot.close()
+
+        @asynccontextmanager
+        async def typing():
+            yield
+
+        allowed_bot = bot_module.BridgeBot(settings(tmp_path / 'allowed-state.json'))
+        allowed_bot.forward_to_codex = AsyncMock()
+        allowed_bot.orca = NS(list_terminals=AsyncMock(return_value=[]))
+        allowed_bot.store.connect('term', 'wt', 'tab:leaf')
+        message = NS(
+            author=NS(id=2, bot=False), webhook_id=None, guild=NS(id=1),
+            channel=NS(id=3, typing=typing), content='owned prompt',
+            reference=None, id=5,
+        )
+        await allowed_bot.on_message(message)
+        allowed_bot.forward_to_codex.assert_awaited_once_with(
+            'owned prompt', origin='Discord message 5',
+        )
+
+        request = interaction(allowed_bot)
+        await bot_module.terminals_command.callback(request)
+        allowed_bot.orca.list_terminals.assert_awaited_once()
+        await allowed_bot.close()
+
+    asyncio.run(run())
+
+
