diff --git a/tests/test_harness_compatibility.py b/tests/test_harness_compatibility.py
index e476a1a..5ca0c39 100644
--- a/tests/test_harness_compatibility.py
+++ b/tests/test_harness_compatibility.py
@@ -172,0 +173,67 @@ def test_discord_message_boundary(tmp_path, change):
+def test_denied_events_do_not_call_orca(tmp_path):
+    async def run():
+        bot = bot_module.BridgeBot(settings(tmp_path / 'state.json'))
+        bot._connection.user = NS(id=99)
+        bot.forward_to_codex = AsyncMock()
+        orca_spies = {
+            name: AsyncMock()
+            for name in (
+                'list_terminals',
+                'validate_codex_binding',
+                'get_agent_snapshot',
+                'resolve_binding',
+                'exchange',
+            )
+        }
+        bot.orca = NS(**orca_spies)
+
+        def message(*, author_id=2, bot_author=False, webhook_id=None, guild_id=1,
+                    channel_id=3, content='owned prompt'):
+            return NS(
+                author=NS(id=author_id, bot=bot_author),
+                webhook_id=webhook_id,
+                guild=None if guild_id is None else NS(id=guild_id),
+                channel=NS(id=channel_id),
+                content=content,
+            )
+
+        denied_messages = [
+            message(guild_id=None),  # DMs fail the shared guild authorization policy.
+            message(guild_id=7),
+            message(author_id=7),
+            message(channel_id=7),
+            message(author_id=99),
+            message(bot_author=True),
+            message(webhook_id=7),
+            message(content='  '),
+        ]
+        for event in denied_messages:
+            await bot.on_message(event)
+
+        denied_command = interaction(bot, guild=7)
+        await bot_module.connect_command.callback(denied_command, 'term')
+        denied_terminals = interaction(bot, user=7)
+        await bot_module.terminals_command.callback(denied_terminals)
+        denied_autocomplete = interaction(bot, user=7)
+        assert await bot_module.terminal_autocomplete(denied_autocomplete, '') == []
+        bot.store.connect('term', 'wt', 'tab:leaf')
+        denied_status = interaction(bot, user=7)
+        await bot_module.status_command.callback(denied_status)
+        denied_context = interaction(bot, user=7)
+        await bot_module.send_to_codex_context.callback(denied_context, NS(content='owned source', embeds=[]))
+
+        denied_command.response.send_message.assert_awaited_once()
+        denied_terminals.response.send_message.assert_awaited_once()
+        denied_autocomplete.response.send_message.assert_not_awaited()
+        denied_status.response.send_message.assert_awaited_once()
+        denied_context.response.send_message.assert_awaited_once()
+        denied_context.response.send_modal.assert_not_awaited()
+        bot.forward_to_codex.assert_not_awaited()
+        for spy in orca_spies.values():
+            spy.assert_not_awaited()
+
+        await bot.close()
+
+    asyncio.run(run())
+
+
