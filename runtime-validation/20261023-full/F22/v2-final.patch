     assert result == "phase 6 metadata (`phases/6/index.json:20`) 갱신"
 
 
+def test_local_markdown_link_preserves_spaces_and_line_suffix():
+    text = "[API guide](/work tree/project/docs/API Guide.md:12:3) 확인"
+
+    result = _filter_assistant_output(text, "/work tree/project")
+
+    assert result == "API guide (`docs/API Guide.md:12:3`) 확인"
+
+
+def test_file_uri_link_decodes_spaces_and_hides_external_locations():
+    local = _filter_assistant_output(
+        "[API guide](file:///work%20tree/project/docs/API%20Guide.md:12)",
+        "/work tree/project",
+    )
+    external = _filter_assistant_output(
+        "[private](file:///Users/alice/private%20area/token.txt:9)",
+        "/Users/alice/project",
+    )
+
+    assert local == "API guide (`docs/API Guide.md:12`)"
+    assert external == "private"
+
+
+def test_markdown_links_hide_paths_outside_bound_worktree():
+    text = "[private file](/Users/alice/private area/token.txt:9)"
+
+    result = _filter_assistant_output(text, "/Users/alice/project")
+
+    assert result == "private file"
+    assert "/Users/alice/private area" not in result
+
+
+def test_markdown_like_text_inside_inline_code_is_not_rewritten():
+    text = (
+        "Use `[literal](/worktree/src/source file.py:3)` as the example; "
+        "see [source](/worktree/src/source file.py:3)."
+    )
+
+    result = _filter_assistant_output(text, "/worktree")
+
+    assert result == (
+        "Use `[literal](/worktree/src/source file.py:3)` as the example; "
+        "see source (`src/source file.py:3`)."
+    )
+
+
+def test_absolute_markdown_link_is_hidden_without_a_bound_worktree():
+    result = _filter_assistant_output("[private](/Users/alice/private.txt:4)")
+
+    assert result == "private"
+
+
+def test_shell_fence_with_options_is_preserved_when_large():
+    commands = "\n".join(f"echo {index}" for index in range(50))
+    text = f"Run these commands:\n```bash -lc\n{commands}\n```\nDone."
+
+    result = _filter_assistant_output(text)
+
+    assert "```bash -lc" in result
+    assert "echo 49" in result
+    assert "긴 코드 블록 생략" not in result
+    assert "Run these commands:" in result and result.endswith("Done.")
+
+
+def test_long_backtick_diff_fence_is_abbreviated_with_surrounding_prose():
+    text = (
+        "Before the changes.\n"
+        "````diff\n"
+        "diff --git a/app.py b/app.py\n"
+        "--- a/app.py\n"
+        "+++ b/app.py\n"
+        "@@ -1 +1 @@\n"
+        "-old = False\n"
+        "+new = True\n"
+        "````\n"
+        "After the changes."
+    )
+
+    result = _filter_assistant_output(text)
+
+    assert "Before the changes." in result
+    assert "After the changes." in result
+    assert "diff/patch 상세 생략" in result
+    assert "old = False" not in result and "new = True" not in result
+
+
+def test_oversized_non_shell_fence_is_abbreviated():
+    body = "\n".join(f"setting_{index} = true" for index in range(46))
+    result = _filter_assistant_output(f"Config:\n```toml\n{body}\n```\nComplete.")
+
+    assert "긴 코드 블록 생략" in result
+    assert "setting_0" not in result
+    assert "Complete." in result
+
+
