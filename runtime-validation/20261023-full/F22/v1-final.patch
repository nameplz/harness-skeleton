+def test_local_links_preserve_spaces_and_line_suffixes_and_hide_external_paths(tmp_path):
+    worktree = tmp_path / "work tree"
+    text = (
+        f"[source]({worktree}/src/my file.py:27:4) and "
+        "[private](/Users/me/private notes/secret.txt:9)"
+    )
+
+    result = _filter_assistant_output(text, str(worktree))
+
+    assert "source (`src/my file.py:27:4`)" in result
+    assert "private" in result
+    assert "/Users/me/private notes/secret.txt" not in result
+
+
+def test_angle_bracket_external_markdown_destination_is_hidden(tmp_path):
+    text = "[private](</outside/path with spaces/file.txt:9>)"
+
+    result = _filter_assistant_output(text, str(tmp_path / "worktree"))
+
+    assert result == "private"
+    assert "/outside/path with spaces/file.txt:9" not in result
+
+
+def test_file_uri_variants_hide_external_absolute_paths(tmp_path):
+    worktree = tmp_path / "worktree"
+    text = (
+        "[upper](<FILE:///outside/secret.txt:9>) and "
+        "[standard](file:/outside/secret.txt:10)"
+    )
+
+    result = _filter_assistant_output(text, str(worktree))
+
+    assert result == "upper and standard"
+    assert "/outside/secret.txt" not in result
+
+
+def test_markdown_like_local_links_inside_inline_code_are_unchanged(tmp_path):
+    worktree = tmp_path / "repo"
+    text = (
+        f"Use [source]({worktree}/src/file.py:12), but literally "
+        f"`[example]({worktree}/src/file.py:13)` here."
+    )
+
+    result = _filter_assistant_output(text, str(worktree))
+
+    assert "source (`src/file.py:12`)" in result
+    assert f"`[example]({worktree}/src/file.py:13)`" in result
+
+
+def test_markdown_like_links_inside_fenced_code_remain_unchanged(tmp_path):
+    worktree = tmp_path / "repo"
+    path = worktree / "src" / "file with spaces.py"
+    text = f"Example:\n\n```text\n[code]({path}:12)\n```"
+
+    result = _filter_assistant_output(text, str(worktree))
+
+    assert f"[code]({path}:12)" in result
+
