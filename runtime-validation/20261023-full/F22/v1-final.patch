+def test_filter_preserves_prose_short_code_and_shell_fence_options():
+    shell_body = "\n".join(f"echo command-{index}" for index in range(50))
+    text = (
+        "설명은 그대로 남습니다.\n\n"
+        "```toml\nsetting = true\n```\n\n"
+        "```bash -lc\n"
+        f"{shell_body}\n"
+        "```\n\n"
+        "마지막 설명도 남습니다."
+    )
+
+    result = _filter_assistant_output(text)
+
+    assert "설명은 그대로 남습니다." in result
+    assert "setting = true" in result
+    assert "```bash -lc" in result
+    assert "echo command-49" in result
+    assert "마지막 설명도 남습니다." in result
+
+
+def test_filter_abbreviates_long_marker_diff_and_oversized_code():
+    code_body = "\n".join(f"value_{index} = {index}" for index in range(46))
+    text = (
+        "Before the changes.\n\n"
+        "````diff\n"
+        "diff --git a/example.py b/example.py\n"
+        "--- a/example.py\n+++ b/example.py\n"
+        "@@ -1 +1 @@\n-old\n+new\n"
+        "````\n\n"
+        "After the diff.\n\n"
+        f"```python\n{code_body}\n```\n\n"
+        "After the code."
+    )
+
+    result = _filter_assistant_output(text)
+
+    assert "Before the changes." in result
+    assert "After the diff." in result
+    assert "After the code." in result
+    assert result.count("_(diff/patch 상세 생략)_") == 1
+    assert "_(긴 코드 블록 생략)_" in result
+    assert "diff --git" not in result
+    assert "value_45" not in result
+
