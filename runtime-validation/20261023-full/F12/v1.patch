+def test_forward_recovers_stale_binding_after_layout_change(tmp_path):
+    class Channel(bot_module.discord.TextChannel):
+        def __init__(self): self.sent=[]
+        async def send(self, value): self.sent.append(value)
+
+    async def run():
+        saved = orca.TerminalBinding('term','wt','tab','leaf')
+        stale_bindings = [
+            ('pane-only', orca.TerminalBinding('term','wt','tab','new-leaf')),
+            ('worktree-only', orca.TerminalBinding('term','new-wt','tab','leaf')),
+        ]
+        for case, live in stale_bindings:
+            path=tmp_path/f'{case}.json'
+            bot=bot_module.BridgeBot(settings(path))
+            bot.store.connect(saved.handle,saved.worktree_id,saved.pane_key)
+            validated=orca.TerminalBinding('term',f'validated-{case}',f'tab-{case}',f'leaf-{case}')
+            channel=Channel();bot.get_channel=lambda _:channel
+            bot.orca=NS(resolve_binding=AsyncMock(return_value=live),
+                        validate_codex_binding=AsyncMock(return_value=validated),
+                        exchange=AsyncMock(return_value=orca.ExchangeResult('validated output','done',False)))
+
+            await bot.forward_to_codex('owned prompt',origin='owned')
+
+            bot.orca.resolve_binding.assert_awaited_once_with(saved.handle)
+            bot.orca.validate_codex_binding.assert_awaited_once_with(saved.handle)
+            bot.orca.exchange.assert_awaited_once_with(validated,'owned prompt')
+            assert bot.store.state.terminal_handle==validated.handle
+            assert bot.store.state.worktree_id==validated.worktree_id
+            assert bot.store.state.pane_key==validated.pane_key
+            assert json.loads(path.read_text())=={
+                'terminal_handle':validated.handle,
+                'worktree_id':validated.worktree_id,
+                'pane_key':validated.pane_key,
+            }
+            assert channel.sent==['validated output']
+            await bot.close()
+
+        unchanged_path=tmp_path/'unchanged.json'
+        unchanged_bot=bot_module.BridgeBot(settings(unchanged_path))
+        unchanged_bot.store.connect(saved.handle,saved.worktree_id,saved.pane_key)
+        unchanged=orca.TerminalBinding('term','wt','tab','leaf')
+        unchanged_channel=Channel();unchanged_bot.get_channel=lambda _:unchanged_channel
+        unchanged_bot.orca=NS(resolve_binding=AsyncMock(return_value=unchanged),
+                              validate_codex_binding=AsyncMock(),
+                              exchange=AsyncMock(return_value=orca.ExchangeResult('unchanged output','done',False)))
+
+        await unchanged_bot.forward_to_codex('owned prompt',origin='owned')
+
+        unchanged_bot.orca.resolve_binding.assert_awaited_once_with(saved.handle)
+        unchanged_bot.orca.validate_codex_binding.assert_not_awaited()
+        unchanged_bot.orca.exchange.assert_awaited_once_with(unchanged,'owned prompt')
+        assert unchanged_bot.store.state.worktree_id==saved.worktree_id
+        assert unchanged_bot.store.state.pane_key==saved.pane_key
+        assert unchanged_channel.sent==['unchanged output']
+        await unchanged_bot.close()
+
+        failed_path=tmp_path/'failed.json'
+        failed_bot=bot_module.BridgeBot(settings(failed_path))
+        failed_bot.store.connect(saved.handle,saved.worktree_id,saved.pane_key)
+        saved_file=json.loads(failed_path.read_text())
+        failed_channel=Channel();failed_bot.get_channel=lambda _:failed_channel
+        failed_bot.orca=NS(resolve_binding=AsyncMock(return_value=orca.TerminalBinding('term','wt','tab','new-leaf')),
+                           validate_codex_binding=AsyncMock(side_effect=orca.OrcaError('stale binding')),
+                           exchange=AsyncMock())
+
+        @asynccontextmanager
+        async def typing():
+            yield
+
+        message=NS(author=NS(id=2,bot=False),webhook_id=None,guild=NS(id=1),
+                   channel=NS(id=3,typing=typing),content='owned prompt',
+                   reference=None,id=4,reply=AsyncMock())
+        await failed_bot.on_message(message)
+
+        failed_bot.orca.validate_codex_binding.assert_awaited_once_with(saved.handle)
+        failed_bot.orca.exchange.assert_not_awaited()
+        message.reply.assert_not_awaited()
+        assert failed_channel.sent==[]
+        assert failed_bot.store.state.terminal_handle==saved.handle
+        assert failed_bot.store.state.worktree_id==saved.worktree_id
+        assert failed_bot.store.state.pane_key==saved.pane_key
+        assert json.loads(failed_path.read_text())==saved_file
+
+        modal=bot_module.ForwardModal(failed_bot,NS(content='owned source',embeds=[]))
+        modal.instruction._value='owned instruction'
+        request=interaction(failed_bot)
+        await modal.on_submit(request)
+
+        assert failed_bot.orca.validate_codex_binding.await_count==2
+        failed_bot.orca.exchange.assert_not_awaited()
+        request.followup.send.assert_not_awaited()
+        assert failed_channel.sent==[]
+        assert failed_bot.store.state.terminal_handle==saved.handle
+        assert failed_bot.store.state.worktree_id==saved.worktree_id
+        assert failed_bot.store.state.pane_key==saved.pane_key
+        assert json.loads(failed_path.read_text())==saved_file
+        await failed_bot.close()
+
+    asyncio.run(run())
+
+
