+def test_forward_recovers_stale_binding_after_layout_change(tmp_path):
+    class Channel(bot_module.discord.TextChannel):
+        def __init__(self): self.sent=[]
+        async def send(self, value): self.sent.append(value)
+
+    async def make_bot(name):
+        bot=bot_module.BridgeBot(settings(tmp_path/f'{name}.json'))
+        bot.store.connect('saved-term','saved-wt','saved-tab:saved-leaf')
+        channel=Channel()
+        bot.get_channel=lambda _:channel
+        return bot,channel
+
+    async def run():
+        validated=orca.TerminalBinding('saved-term','validated-wt','validated-tab','validated-leaf')
+        result=orca.ExchangeResult('owned assistant reply','done')
+
+        # Pane-only and worktree-only layout changes both require validation. The
+        # exchange and persisted state must use what validation returned.
+        for name,live in (
+            ('pane-change',orca.TerminalBinding('saved-term','saved-wt','new-tab','new-leaf')),
+            ('worktree-change',orca.TerminalBinding('saved-term','new-wt','saved-tab','saved-leaf')),
+        ):
+            bot,channel=await make_bot(name)
+            bot.orca=NS(resolve_binding=AsyncMock(return_value=live),
+                        validate_codex_binding=AsyncMock(return_value=validated),
+                        exchange=AsyncMock(return_value=result))
+
+            await bot.forward_to_codex('owned prompt',origin='owned')
+
+            bot.orca.resolve_binding.assert_awaited_once_with('saved-term')
+            bot.orca.validate_codex_binding.assert_awaited_once_with('saved-term')
+            bot.orca.exchange.assert_awaited_once_with(validated,'owned prompt')
+            assert (bot.store.state.terminal_handle,bot.store.state.worktree_id,bot.store.state.pane_key)==(
+                'saved-term','validated-wt','validated-tab:validated-leaf')
+            assert json.loads(bot.store.path.read_text())=={
+                'terminal_handle':'saved-term',
+                'worktree_id':'validated-wt',
+                'pane_key':'validated-tab:validated-leaf',
+            }
+            assert channel.sent==['owned assistant reply']
+            await bot.close()
+
+        # An unchanged identity is exchanged directly without a second validation.
+        bot,channel=await make_bot('unchanged')
+        unchanged=orca.TerminalBinding('saved-term','saved-wt','saved-tab','saved-leaf')
+        bot.orca=NS(resolve_binding=AsyncMock(return_value=unchanged),
+                    validate_codex_binding=AsyncMock(),
+                    exchange=AsyncMock(return_value=result))
+
+        await bot.forward_to_codex('owned prompt',origin='owned')
+
+        bot.orca.resolve_binding.assert_awaited_once_with('saved-term')
+        bot.orca.validate_codex_binding.assert_not_awaited()
+        bot.orca.exchange.assert_awaited_once_with(unchanged,'owned prompt')
+        assert channel.sent==['owned assistant reply']
+        await bot.close()
+
+        # Failed validation must neither exchange/send a channel reply nor change
+        # the last known good binding in memory or on disk.
+        bot,channel=await make_bot('validation-failed')
+        saved_state=json.loads(bot.store.path.read_text())
+        changed=orca.TerminalBinding('saved-term','new-wt','saved-tab','saved-leaf')
+        bot.orca=NS(resolve_binding=AsyncMock(return_value=changed),
+                    validate_codex_binding=AsyncMock(side_effect=orca.OrcaError('validation failed')),
+                    exchange=AsyncMock())
+
+        @asynccontextmanager
+        async def typing():
+            yield
+
+        message=NS(author=NS(id=2,bot=False),webhook_id=None,guild=NS(id=1),
+                   channel=NS(id=3,typing=typing),content='owned prompt',reference=None,
+                   id=9,reply=AsyncMock())
+        await bot.on_message(message)
+
+        bot.orca.validate_codex_binding.assert_awaited_once_with('saved-term')
+        bot.orca.exchange.assert_not_awaited()
+        assert channel.sent==[]
+        message.reply.assert_not_awaited()
+        assert (bot.store.state.terminal_handle,bot.store.state.worktree_id,bot.store.state.pane_key)==(
+            'saved-term','saved-wt','saved-tab:saved-leaf')
+        assert json.loads(bot.store.path.read_text())==saved_state
+        await bot.close()
+
+    asyncio.run(run())
+
+
