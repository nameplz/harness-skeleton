+def _untrusted_source_block(source: str) -> str:
+    """Render source data without allowing it to reproduce either boundary."""
+    source = source.replace(_DISCORD_SOURCE_START, "[escaped source start boundary]")
+    source = source.replace(_DISCORD_SOURCE_END, "[escaped source end boundary]")
+    return f"{_DISCORD_SOURCE_START}\n{source}\n{_DISCORD_SOURCE_END}"
+
