+@pytest.mark.parametrize(('guild','user','allowed'), [(1,2,True),(1,7,False),(7,2,False)])
+def test_context_menu_authorization_call_spy(tmp_path,guild,user,allowed):
+    async def run():
+        bot=bot_module.BridgeBot(settings(tmp_path/'state.json'))
+        bot.forward_to_codex=AsyncMock()
+        request=interaction(bot,guild=guild,user=user)
+        source=NS(content='selected source',embeds=[])
+        await bot_module.send_to_codex_context.callback(request,source)
+        if allowed:
+            request.response.send_modal.assert_awaited_once()
+            modal=request.response.send_modal.call_args.args[0]
+            assert isinstance(modal,bot_module.ForwardModal)
+            assert modal.source is source
+        else:
+            request.response.send_message.assert_awaited_once()
+            request.response.send_modal.assert_not_awaited()
+        bot.forward_to_codex.assert_not_awaited()
+        await bot.close()
+    asyncio.run(run())
+
