--- a/src/orca_discord_bridge/config.py
+++ b/src/orca_discord_bridge/config.py
@@ -21,6 +21,31 @@ def _required_int(name: str) -> int:
         raise ConfigError(f"{name} must be an integer Discord ID") from exc
 
 
+def _additional_channel_ids(legacy_channel_id: int) -> tuple[int, ...]:
+    raw = os.getenv("CODEX_CHANNEL_IDS", "")
+    if not raw.strip():
+        return ()
+
+    channel_ids: list[int] = []
+    seen = {legacy_channel_id}
+    for entry in raw.split(","):
+        value = entry.strip()
+        if not value:
+            raise ConfigError(
+                "CODEX_CHANNEL_IDS must be a comma-separated list of integer Discord IDs"
+            )
+        try:
+            channel_id = int(value)
+        except ValueError as exc:
+            raise ConfigError(
+                "CODEX_CHANNEL_IDS must be a comma-separated list of integer Discord IDs"
+            ) from exc
+        if channel_id not in seen:
+            channel_ids.append(channel_id)
+            seen.add(channel_id)
+    return tuple(channel_ids)
+
+
 @dataclass(frozen=True, slots=True)
 class Settings:
     discord_token: str
