@@ -21,6 +21,28 @@ def _required_int(name: str) -> int:
         raise ConfigError(f"{name} must be an integer Discord ID") from exc
 
 
+def _optional_int_list(name: str) -> tuple[int, ...]:
+    value = os.getenv(name, "")
+    if not value.strip():
+        return ()
+
+    result = []
+    seen = set()
+    for raw_entry in value.split(","):
+        entry = raw_entry.strip()
+        try:
+            channel_id = int(entry)
+        except ValueError as exc:
+            raise ConfigError(
+                f"{name} must be a comma-separated list of integer Discord IDs; "
+                f"invalid entry: {entry!r}"
+            ) from exc
+        if channel_id not in seen:
+            seen.add(channel_id)
+            result.append(channel_id)
+    return tuple(result)
+
+
