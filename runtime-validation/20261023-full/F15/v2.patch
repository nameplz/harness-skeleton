+        'STATE_PATH':str(tmp_path/'state.json'),
+        'ORCA_WAIT_TIMEOUT_MS':'1000',
+    }.items():
+        monkeypatch.setenv(key,value)
+    if raw is None:
+        monkeypatch.delenv('CODEX_CHANNEL_IDS',raising=False)
+    else:
+        monkeypatch.setenv('CODEX_CHANNEL_IDS',raw)
