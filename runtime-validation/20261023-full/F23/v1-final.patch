--- a/src/orca_discord_bridge/config.py
+++ b/src/orca_discord_bridge/config.py
@@ -6,6 +6,8 @@ from pathlib import Path
 
 from dotenv import load_dotenv
 
+_MAX_DISCORD_ID = "18446744073709551615"
+
 
 class ConfigError(RuntimeError):
     pass
@@ -21,6 +23,31 @@ def _required_int(name: str) -> int:
         raise ConfigError(f"{name} must be an integer Discord ID") from exc
 
 
+def _optional_int_list(name: str) -> tuple[int, ...]:
+    value = os.getenv(name, "").strip()
+    if not value:
+        return ()
+
+    parts = [part.strip() for part in value.split(",")]
+    if any(not part or not part.isascii() or not part.isdecimal() for part in parts):
+        raise ConfigError(f"{name} must be a comma-separated list of integer Discord IDs")
+
+    role_ids = []
+    for part in parts:
+        normalized = part.lstrip("0")
+        if not normalized:
+            raise ConfigError(f"{name} must contain positive uint64 Discord IDs")
+        if len(normalized) > len(_MAX_DISCORD_ID) or (
+            len(normalized) == len(_MAX_DISCORD_ID) and normalized > _MAX_DISCORD_ID
+        ):
+            raise ConfigError(f"{name} must contain positive uint64 Discord IDs")
+        try:
+            role_ids.append(int(normalized))
+        except ValueError as exc:
+            raise ConfigError(f"{name} must contain positive uint64 Discord IDs") from exc
+    return tuple(dict.fromkeys(role_ids))
+
+
