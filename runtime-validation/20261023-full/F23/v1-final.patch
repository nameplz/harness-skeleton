+def test_context_menu_and_modal_use_role_authorization_before_forwarding(tmp_path):
+    async def run():
+        bot=bot_module.BridgeBot(settings(tmp_path/'state.json',(10,)))
+        bot.store.connect('term','wt','tab:leaf')
+        bot.forward_to_codex=AsyncMock()
+        source=NS(content='owned source',embeds=[])
+
+        for identity in ('owner','role'):
+            guild,user,roles=authorization_case(identity)
+            request=interaction(bot,guild=guild,user=user,roles=roles)
+            await bot_module.send_to_codex_context.callback(request,source)
+            request.response.send_modal.assert_awaited_once()
+            modal=request.response.send_modal.call_args.args[0]
+            modal.instruction._value='owned instruction'
+            submit=interaction(bot,guild=guild,user=user,roles=roles)
+            await modal.on_submit(submit)
+            bot.forward_to_codex.assert_awaited_once()
+            bot.forward_to_codex.reset_mock()
+
+        for identity in ('wrong-role','wrong-user','wrong-guild','dm-role','dm-owner'):
+            guild,user,roles=authorization_case(identity)
+            request=interaction(bot,guild=guild,user=user,roles=roles)
+            await bot_module.send_to_codex_context.callback(request,source)
+            request.response.send_message.assert_awaited_once()
+            request.response.send_modal.assert_not_awaited()
+
+            modal=bot_module.ForwardModal(bot,source)
+            modal.instruction._value='owned instruction'
+            submit=interaction(bot,guild=guild,user=user,roles=roles)
+            await modal.on_submit(submit)
+            submit.response.send_message.assert_awaited_once()
+            bot.forward_to_codex.assert_not_awaited()
+        await bot.close()
+    asyncio.run(run())
+
