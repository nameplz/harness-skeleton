+def _optional_ints(name: str) -> frozenset[int]:
+    value = os.getenv(name, "").strip()
+    if not value:
+        return frozenset()
+    items = [item.strip() for item in value.split(",")]
+    if any(not item for item in items):
+        raise ConfigError(f"{name} must be a comma-separated list of integer Discord IDs")
+    try:
+        return frozenset(int(item) for item in items)
+    except ValueError as exc:
+        raise ConfigError(f"{name} must be a comma-separated list of integer Discord IDs") from exc
+
+
