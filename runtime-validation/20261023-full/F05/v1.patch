+def test_denied_events_do_not_call_orca(tmp_path):
+    async def run():
+        bot = bot_module.BridgeBot(settings(tmp_path / 'state.json'))
+        bot._connection.user = NS(id=99)
+        bot.store.connect('term', 'wt', 'tab:leaf')
+        binding = orca.TerminalBinding('term', 'wt', 'tab', 'leaf')
+        bot.orca = NS(
+            list_terminals=AsyncMock(return_value=[]),
+            validate_codex_binding=AsyncMock(return_value=binding),
+            get_agent_snapshot=AsyncMock(return_value=orca._parse_agent_snapshot(row())),
+            resolve_binding=AsyncMock(return_value=binding),
+            exchange=AsyncMock(return_value=orca.ExchangeResult('owned output', 'done', False)),
+        )
+        bot.forward_to_codex = AsyncMock()
+
+        denied_messages = [
+            NS(author=NS(id=2, bot=False), webhook_id=None, guild=None,
+               channel=NS(id=3), content='owned prompt'),
+            NS(author=NS(id=2, bot=False), webhook_id=None, guild=NS(id=7),
+               channel=NS(id=3), content='owned prompt'),
+            NS(author=NS(id=7, bot=False), webhook_id=None, guild=NS(id=1),
+               channel=NS(id=3), content='owned prompt'),
+            NS(author=NS(id=2, bot=False), webhook_id=None, guild=NS(id=1),
+               channel=NS(id=7), content='owned prompt'),
+            NS(author=NS(id=8, bot=True), webhook_id=None, guild=NS(id=1),
+               channel=NS(id=3), content='owned prompt'),
+            NS(author=NS(id=8, bot=False), webhook_id=7, guild=NS(id=1),
+               channel=NS(id=3), content='owned prompt'),
+            NS(author=NS(id=99, bot=False), webhook_id=None, guild=NS(id=1),
+               channel=NS(id=3), content='owned prompt'),
+            NS(author=NS(id=2, bot=False), webhook_id=None, guild=NS(id=1),
+               channel=NS(id=3), content='  '),
+        ]
+        for message in denied_messages:
+            await bot.on_message(message)
+
+        denied_commands = [
+            ('terminals_command', interaction(bot, user=7), ()),
+            ('connect_command', interaction(bot, guild=7), ('term',)),
+            ('status_command', interaction(bot, user=7), ()),
+            ('disconnect_command', interaction(bot, guild=7), ()),
+        ]
+        for name, request, args in denied_commands:
+            await getattr(bot_module, name).callback(request, *args)
+            request.response.send_message.assert_awaited_once()
+
+        source = NS(content='owned context', embeds=[])
+        request = interaction(bot, user=7)
+        await bot_module.send_to_codex_context.callback(request, source)
+        request.response.send_message.assert_awaited_once()
+        request.response.send_modal.assert_not_awaited()
+
+        for method in (
+            bot.forward_to_codex,
+            bot.orca.list_terminals,
+            bot.orca.validate_codex_binding,
+            bot.orca.get_agent_snapshot,
+            bot.orca.resolve_binding,
+            bot.orca.exchange,
+        ):
+            method.assert_not_awaited()
+        await bot.close()
+    asyncio.run(run())
+
