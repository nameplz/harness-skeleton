+def test_denied_events_do_not_call_orca(tmp_path):
+    @asynccontextmanager
+    async def typing():
+        yield
+
+    async def run():
+        bot = bot_module.BridgeBot(settings(tmp_path / 'state.json'))
+        bot._connection.user = NS(id=99)
+        bot.store.connect('term', 'wt', 'tab:leaf')
+        bot.forward_to_codex = AsyncMock()
+        bot.orca = NS(
+            list_terminals=AsyncMock(return_value=[]),
+            validate_codex_binding=AsyncMock(return_value=orca.TerminalBinding('term', 'wt', 'tab', 'leaf')),
+            get_agent_snapshot=AsyncMock(return_value=NS(state='done')),
+            resolve_binding=AsyncMock(return_value=orca.TerminalBinding('term', 'wt', 'tab', 'leaf')),
+            exchange=AsyncMock(return_value=orca.ExchangeResult('', 'done', False)),
+        )
+
+        message_cases = (
+            {'guild': None},
+            {'guild': NS(id=7)},
+            {'author': NS(id=7, bot=False)},
+            {'channel': NS(id=7, typing=typing)},
+            {'author': NS(id=99, bot=False)},
+            {'webhook_id': 7},
+            {'author': NS(id=2, bot=True)},
+            {'content': '   '},
+        )
+        for overrides in message_cases:
+            message = NS(
+                author=NS(id=2, bot=False),
+                webhook_id=None,
+                guild=NS(id=1),
+                channel=NS(id=3, typing=typing),
+                content='owned prompt',
+                reference=None,
+                id=4,
+                reply=AsyncMock(),
+            )
+            for key, value in overrides.items():
+                setattr(message, key, value)
+            await bot.on_message(message)
+
+        for name in ('terminals_command', 'connect_command', 'status_command', 'disconnect_command'):
+            for request, denial in (
+                (interaction(bot, guild=7), '이 서버에서는 사용할 수 없습니다.'),
+                (interaction(bot, user=7), '허용된 사용자만 사용할 수 있습니다.'),
+            ):
+                args = (request, 'term') if name == 'connect_command' else (request,)
+                await getattr(bot_module, name).callback(*args)
+                request.response.send_message.assert_awaited_once_with(denial, ephemeral=True)
+
+        source = NS(content='owned untrusted context', embeds=[])
+        for request, denial in (
+            (interaction(bot, guild=7), '이 서버에서는 사용할 수 없습니다.'),
+            (interaction(bot, user=7), '허용된 사용자만 사용할 수 있습니다.'),
+        ):
+            await bot_module.send_to_codex_context.callback(request, source)
+            request.response.send_message.assert_awaited_once_with(denial, ephemeral=True)
+            request.response.send_modal.assert_not_awaited()
+
+        bot.forward_to_codex.assert_not_awaited()
+        for method in (
+            bot.orca.list_terminals,
+            bot.orca.validate_codex_binding,
+            bot.orca.get_agent_snapshot,
+            bot.orca.resolve_binding,
+            bot.orca.exchange,
+        ):
+            method.assert_not_awaited()
+        await bot.close()
+
+    asyncio.run(run())
+
