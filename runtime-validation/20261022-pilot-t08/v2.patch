 _CONTROL_RE = re.compile(r"[\x00-\x08\x0b\x0c\x0e-\x1f\x7f]")
+_FORWARDED_BOUNDARIES = ("--- Discord message ---", "--- End message ---")
+_REPLIED_BOUNDARIES = ("--- Referenced message ---", "--- End referenced message ---")
+
+
+def _escape_boundary_markers(text: str, markers: tuple[str, ...]) -> str:
+    """Keep untrusted message text from reproducing a prompt boundary marker."""
+    for marker in markers:
+        escaped = marker.replace("---", r"\x2d\x2d\x2d")
+        text = text.replace(marker, escaped)
+    return text
 
 
