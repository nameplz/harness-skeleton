+def test_unresolved_reply_fetches_once_and_forwards_fetched_message(tmp_path):
+    @asynccontextmanager
+    async def typing():
+        yield
+    async def run():
+        bot=bot_module.BridgeBot(settings(tmp_path/'state.json'))
+        bot.store.connect('term','wt','tab:leaf')
+        bot.forward_to_codex=AsyncMock()
+        embed=bot_module.discord.Embed(title='fetched title',description='fetched description',url='https://example.invalid/fetched')
+        referenced=MagicMock(spec=bot_module.discord.Message)
+        referenced.content='fetched reply content'
+        referenced.embeds=[embed]
+        channel=NS(id=3,typing=typing,fetch_message=AsyncMock(return_value=referenced))
+        message=NS(author=NS(id=2,bot=False),webhook_id=None,guild=NS(id=1),channel=channel,
+                   content='owned user instruction',reference=NS(message_id=88,channel_id=3,resolved=None),id=4,
+                   reply=AsyncMock())
+        referenced.channel=NS(id=3)
+
+        await bot.on_message(message)
+
+        channel.fetch_message.assert_awaited_once_with(88)
+        bot.forward_to_codex.assert_awaited_once()
+        prompt=bot.forward_to_codex.call_args.args[0]
+        assert 'fetched reply content' in prompt
+        assert 'fetched title' in prompt and 'fetched description' in prompt
+        assert 'https://example.invalid/fetched' in prompt
+        assert '사용자 지시: owned user instruction' in prompt
+        await bot.close()
+    asyncio.run(run())
+
+
+def test_resolved_cross_channel_reply_is_not_quoted(tmp_path):
+    @asynccontextmanager
+    async def typing():
+        yield
+    async def run():
+        bot=bot_module.BridgeBot(settings(tmp_path/'state.json'))
+        bot.store.connect('term','wt','tab:leaf')
+        bot.forward_to_codex=AsyncMock()
+        channel=NS(id=3,typing=typing,fetch_message=AsyncMock())
+        referenced=MagicMock(spec=bot_module.discord.Message)
+        referenced.channel=NS(id=7)
+        referenced.content='CROSS_CHANNEL_SECRET'
+        referenced.embeds=[]
+        message=NS(author=NS(id=2,bot=False),webhook_id=None,guild=NS(id=1),channel=channel,
+                   content='owned user instruction',reference=NS(message_id=88,channel_id=7,resolved=referenced),id=4,
+                   reply=AsyncMock())
+
+        await bot.on_message(message)
+
+        channel.fetch_message.assert_not_awaited()
+        bot.forward_to_codex.assert_awaited_once_with('owned user instruction',origin='Discord message 4')
+        await bot.close()
+    asyncio.run(run())
