@@ -21,6 +21,31 @@ def _required_int(name: str) -> int:
         raise ConfigError(f"{name} must be an integer Discord ID") from exc
 
 
+def _optional_int_list(name: str) -> tuple[int, ...]:
+    raw = os.getenv(name, "").strip()
+    if not raw:
+        return ()
+
+    values: list[int] = []
+    seen: set[int] = set()
+    for entry in raw.split(","):
+        entry = entry.strip()
+        if not entry:
+            raise ConfigError(
+                f"{name} must be a comma-separated list of integer Discord IDs"
+            )
+        try:
+            value = int(entry)
+        except ValueError as exc:
+            raise ConfigError(
+                f"{name} must be a comma-separated list of integer Discord IDs"
+            ) from exc
+        if value not in seen:
+            values.append(value)
+            seen.add(value)
+    return tuple(values)
+
+
