+def test_codex_channel_list_configuration(monkeypatch, tmp_path):
+    monkeypatch.setattr(config,'load_dotenv',lambda:None)
+    for key,value in {'DISCORD_TOKEN':'OWNED_SYNTHETIC_TOKEN','DISCORD_GUILD_ID':'1','DISCORD_USER_ID':'2','CODEX_CHANNEL_ID':'3','STATE_PATH':str(tmp_path/'state.json'),'ORCA_WAIT_TIMEOUT_MS':'1000'}.items():
+        monkeypatch.setenv(key,value)
+    monkeypatch.delenv('CODEX_CHANNEL_IDS',raising=False)
+
+    legacy_only = config.Settings.load()
+    assert legacy_only.codex_channel_ids == ()
+    assert legacy_only.codex_input_channel_ids == frozenset({3})
+
+    monkeypatch.setenv('CODEX_CHANNEL_IDS',' 4 , 5,4, 3,, ')
+    configured = config.Settings.load()
+    assert configured.codex_channel_ids == (4,5)
+    assert configured.codex_input_channel_ids == frozenset({3,4,5})
+
+    monkeypatch.setenv('CODEX_CHANNEL_IDS','   ')
+    assert config.Settings.load().codex_input_channel_ids == frozenset({3})
+    invalid_id = 'not-an-id'
