+    @staticmethod
+    async def _terminate_and_reap(
+        proc: asyncio.subprocess.Process,
+        communication: asyncio.Task[tuple[bytes, bytes]],
+    ) -> None:
+        if proc.returncode is None:
+            try:
+                # kill() cannot be ignored by the child and bounds cleanup when
+                # it has installed a SIGTERM handler or otherwise refuses exit.
+                proc.kill()
+            except ProcessLookupError:
+                # The child can exit between checking returncode and signaling it.
+                pass
+
+        while not communication.done():
+            try:
+                await asyncio.shield(communication)
+            except asyncio.CancelledError:
+                # Finish cleanup even if cancellation is requested again while reaping.
+                continue
+            except Exception:
+                # The communication task is complete; preserve the timeout or
+                # cancellation that caused cleanup rather than replacing it.
+                break
+
+        if communication.done() and not communication.cancelled():
+            try:
+                communication.result()
+            except Exception:
+                # The child has completed. Keep the original timeout/cancellation.
+                pass
+
+        if proc.returncode is None:
+            reaping = asyncio.create_task(proc.wait())
+            while not reaping.done():
+                try:
+                    await asyncio.shield(reaping)
+                except asyncio.CancelledError:
+                    # Keep waiting for the direct child even after another cancel.
+                    continue
+            try:
+                reaping.result()
+            except Exception:
+                # Preserve the timeout/cancellation that initiated cleanup.
+                pass
+
