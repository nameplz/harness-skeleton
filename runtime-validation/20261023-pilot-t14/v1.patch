+def test_cli_timeout_kills_and_reaps_sigterm_ignoring_child(cli, monkeypatch, tmp_path):
+    client, _ = cli
+    monkeypatch.setenv('FAKE_ORCA_MODE', 'ignore-term')
+    ready = tmp_path / 'fake-cli-ready'
+    monkeypatch.setenv('FAKE_ORCA_READY', str(ready))
+    captured = []
+    create_subprocess_exec = asyncio.create_subprocess_exec
+
+    async def capture_process(*args, **kwargs):
+        process = await create_subprocess_exec(*args, **kwargs)
+        captured.append(process)
+        return process
+
+    monkeypatch.setattr(orca.asyncio, 'create_subprocess_exec', capture_process)
+
+    async def run():
+        task = asyncio.create_task(client._run('status', '--json', timeout=1.5))
+        cleanup_completed = False
+        async def wait_until_ready():
+            while not ready.exists():
+                await asyncio.sleep(.01)
+        try:
+            await asyncio.wait_for(wait_until_ready(), timeout=1)
+            done, _ = await asyncio.wait({task}, timeout=2.5)
+            task_finished = task in done
+            cleanup_completed = (
+                task_finished
+                and len(captured) == 1
+                and captured[0].returncode is not None
+            )
+            if task_finished:
+                with pytest.raises(orca.OrcaError, match='timed out'):
+                    task.result()
+        finally:
+            if captured:
+                process = captured[0]
+                if process.returncode is None:
+                    try:
+                        process.kill()
+                    except ProcessLookupError:
+                        pass
+                await process.wait()
+            if not task.done():
+                await asyncio.wait({task}, timeout=1)
+            if task.done():
+                try:
+                    task.result()
+                except BaseException:
+                    pass
+        assert cleanup_completed
+
+    asyncio.run(run())
+
+    assert len(captured) == 1
+    assert captured[0].returncode is not None
+
+
+def test_cli_cancellation_kills_and_reaps_sigterm_ignoring_child(cli, monkeypatch, tmp_path):
+    client, _ = cli
+    monkeypatch.setenv('FAKE_ORCA_MODE', 'ignore-term')
+    ready = tmp_path / 'fake-cli-ready'
+    monkeypatch.setenv('FAKE_ORCA_READY', str(ready))
+
+    async def run():
+        captured = []
+        process_started = asyncio.Event()
+        create_subprocess_exec = asyncio.create_subprocess_exec
+
+        async def capture_process(*args, **kwargs):
+            process = await create_subprocess_exec(*args, **kwargs)
+            captured.append(process)
+            process_started.set()
+            return process
+
+        monkeypatch.setattr(orca.asyncio, 'create_subprocess_exec', capture_process)
+        task = asyncio.create_task(client._run('status', '--json', timeout=10))
+        cleanup_completed = False
+        async def wait_until_ready():
+            while not ready.exists():
+                await asyncio.sleep(.01)
+        try:
+            await asyncio.wait_for(process_started.wait(), timeout=1)
+            await asyncio.wait_for(wait_until_ready(), timeout=1)
+            task.cancel()
+            done, _ = await asyncio.wait({task}, timeout=1)
+            task_finished = task in done
+            cleanup_completed = (
+                task_finished
+                and len(captured) == 1
+                and captured[0].returncode is not None
+            )
+            if task_finished:
+                with pytest.raises(asyncio.CancelledError):
+                    task.result()
+        finally:
+            if captured:
+                process = captured[0]
+                if process.returncode is None:
+                    try:
+                        process.kill()
+                    except ProcessLookupError:
+                        pass
+                await process.wait()
+            if not task.done():
+                await asyncio.wait({task}, timeout=1)
+            if task.done():
+                try:
+                    task.result()
+                except BaseException:
+                    pass
+
+        assert cleanup_completed
+        assert len(captured) == 1
+        assert captured[0].returncode is not None
+
+    asyncio.run(run())
+
