--- a/tests/test_orca_parsing.py
+++ b/tests/test_orca_parsing.py
@@ -109,0 +110,40 @@ diff --git a/a.py b/a.py
+def test_filter_abbreviates_large_code_but_keeps_prose_and_shell_commands():
+    python_lines = "\n".join(f"print({index})" for index in range(46))
+    shell_lines = "\n".join(f"echo {index}" for index in range(46))
+    text = (
+        "설명 시작.\n\n"
+        "```python linenos\n" + python_lines + "\n```\n\n"
+        "```bash -e\n" + shell_lines + "\n```\n\n"
+        "설명 끝."
+    )
+
+    result = _filter_assistant_output(text)
+
+    assert result.startswith("설명 시작.")
+    assert result.endswith("설명 끝.")
+    assert "_(긴 코드 블록 생략)_" in result
+    assert "print(0)" not in result
+    assert "echo 0" in result and "echo 45" in result
+    assert "```bash -e" in result
+
+
+def test_filter_abbreviates_unfenced_diff_and_preserves_following_prose():
+    text = """변경 내용을 확인했습니다.
+diff --git a/config.toml b/config.toml
+new file mode 100644
+index 0000000..1234567
+--- a/config.toml
++++ b/config.toml
+@@ -1,2 +1,2 @@
+-enabled = false
++enabled = true
+ unchanged = "context"
+추가 설명입니다."""
+
+    result = _filter_assistant_output(text)
+
+    assert result == "변경 내용을 확인했습니다.\n_(diff/patch 상세 생략)_\n추가 설명입니다."
+    assert "enabled = true" not in result
+    assert "unchanged" not in result
+
+
@@ -149,0 +190,16 @@ def test_local_markdown_links_become_readable_relative_paths():
+def test_local_links_in_code_are_preserved_and_encoded_worktree_links_are_readable():
