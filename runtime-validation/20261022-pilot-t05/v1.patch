+
+def test_filter_preserves_prose_after_unfenced_diff_without_blank_line():
+    text = """변경을 확인했습니다.
+diff --git a/a.py b/a.py
+--- a/a.py
++++ b/a.py
+@@ -1 +1 @@
+-old = false
++new = true
+이제 설정이 활성화되어 있습니다."""
+
+    result = _filter_assistant_output(text)
+
+    assert "변경을 확인했습니다." in result
+    assert "_(diff/patch 상세 생략)_" in result
+    assert "이제 설정이 활성화되어 있습니다." in result
+    assert "old = false" not in result
+    assert "new = true" not in result
+
+
+def test_filter_preserves_immediately_adjacent_prose_bullet_after_diff():
+    text = """diff --git a/a.py b/a.py
+--- a/a.py
++++ b/a.py
+@@ -1 +1 @@
+-old = false
++new = true
+- The updated setting is now enabled."""
+
+    result = _filter_assistant_output(text)
+
+    assert "_(diff/patch 상세 생략)_" in result
+    assert "old = false" not in result
+    assert "new = true" not in result
+    assert "- The updated setting is now enabled." in result
+
+
+def test_filter_consumes_fenced_looking_context_lines_inside_unfenced_diff():
+    text = """diff --git a/a.py b/a.py
+--- a/a.py
++++ b/a.py
+@@ -1,4 +1,4 @@
+ ```text
+ secret diff context
+ ```
+-old = false
++new = true
+The updated setting is now enabled."""
+
+    result = _filter_assistant_output(text)
+
+    assert "_(diff/patch 상세 생략)_" in result
+    assert "secret diff context" not in result
+    assert "```text" not in result
+    assert "old = false" not in result
+    assert "new = true" not in result
+    assert "The updated setting is now enabled." in result
+
+
+def test_filter_abbreviates_traditional_absolute_path_diff_headers():
+    text = """Before the change details.
+--- /workspace/project/src/old.py
++++ /workspace/project/src/new.py
+@@ -1 +1 @@
+-old = false
++new = true
+- The setting is now enabled."""
+
+    result = _filter_assistant_output(text)
+
+    assert "Before the change details." in result
+    assert "_(diff/patch 상세 생략)_" in result
+    assert "/workspace/project/src/old.py" not in result
+    assert "/workspace/project/src/new.py" not in result
+    assert "old = false" not in result
+    assert "new = true" not in result
+    assert "- The setting is now enabled." in result
+
+
+def test_filter_keeps_unpaired_diff_like_prose():
+    text = "--- oldfile is a note\n+++ newfile is another note"
+
+    assert _filter_assistant_output(text) == text
